<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Şifrəni Dəyiş – One Loto</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<style>
*{ box-sizing:border-box; margin:0; padding:0; }
::-webkit-scrollbar{ display:none; }
html,body{ overflow-x:hidden; }
body{ background:#3d0d62; color:#fff; font-family:'Inter',sans-serif; min-height:100vh; padding-top:72px; padding-bottom:24px; }

.wrap{ width:100%; max-width:414px; margin:0 auto; padding:14px 16px 24px; }
.back-btn{
  display:flex; align-items:center; gap:6px;
  color:rgba(255,255,255,.7); font-size:14px;
  font-weight:600; text-decoration:none; margin-bottom:20px;
}
.page-title{ font-size:22px; font-weight:900; margin-bottom:20px; }

.form-section{
  background: rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.12);
  border-radius:16px; padding:20px;
}
.form-group{ margin-bottom:16px; }
.form-label{
  display:block; font-size:12px; font-weight:700;
  color:rgba(255,255,255,.6); margin-bottom:6px;
  text-transform:uppercase; letter-spacing:.4px;
}
.form-input{
  width:100%; padding:13px 16px;
  background: rgba(255,255,255,.1);
  border:1.5px solid rgba(255,255,255,.2);
  border-radius:12px;
  color:#fff; font-size:15px; font-weight:600;
  font-family:'Inter',sans-serif; outline:none;
  transition: border-color .2s;
}
.form-input:focus{ border-color:#f5c518; }
.form-input::placeholder{ color:rgba(255,255,255,.35); }

.pwd-wrap{ position:relative; }
.pwd-wrap .form-input{ padding-right:48px; }
.eye-btn{
  position:absolute; right:14px; top:50%; transform:translateY(-50%);
  background:none; border:none; cursor:pointer;
  color:rgba(255,255,255,.5); display:flex; align-items:center;
}

.error-msg{
  background: rgba(232,0,26,.15); border:1px solid rgba(232,0,26,.3);
  border-radius:10px; padding:10px 14px;
  font-size:13px; color:#ff8080; margin-bottom:14px; text-align:center;
}
.success-msg{
  background: rgba(0,200,100,.15); border:1px solid rgba(0,200,100,.3);
  border-radius:10px; padding:10px 14px;
  font-size:13px; color:#60e0a0; margin-bottom:14px; text-align:center;
}
.btn-save{
  width:100%; padding:14px;
  background: linear-gradient(180deg,#9b4dd4 0%,#6b1fa8 100%);
  color:#fff; font-size:15px; font-weight:900;
  border:none; border-radius:12px; cursor:pointer;
  font-family:'Inter',sans-serif; margin-top:4px;
}
.code-box{ display:flex; gap:8px; justify-content:space-between; margin:6px 0 4px; }
.code-box input{
  flex:1; min-width:0; text-align:center; padding:14px 0;
  background:rgba(0,0,0,.28); border:1.5px solid rgba(255,255,255,.2);
  border-radius:12px; color:#f5c518; font-size:22px; font-weight:900;
  font-family:'Inter',monospace; outline:none;
}
.code-box input:focus{ border-color:#f5c518; }
.mail-note{ font-size:13px; color:rgba(255,255,255,.75); line-height:1.55; margin-bottom:14px; }
.mail-note b{ color:#f5c518; }
.timer{ text-align:center; font-size:12.5px; font-weight:700; color:rgba(255,255,255,.6); margin-top:10px; }
.timer b{ color:#f5c518; }
.row-2{ display:flex; gap:8px; margin-top:10px; }
.btn-ghost{
  flex:1; padding:12px; background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.18); color:#fff;
  border-radius:12px; font-size:13px; font-weight:800; cursor:pointer; font-family:'Inter',sans-serif;
}
.step-badge{
  display:inline-block; font-size:11px; font-weight:800; letter-spacing:.4px;
  background:rgba(245,197,24,.16); color:#f5c518; border:1px solid rgba(245,197,24,.35);
  border-radius:99px; padding:4px 11px; margin-bottom:12px;
}
.help-text{
  font-size:12px; color:rgba(255,255,255,.55);
  margin-top:14px; line-height:1.5;
}

@supports (padding: max(0px)) {
  body{ padding-top: max(72px, calc(72px + env(safe-area-inset-top))); }
}
</style>
</head>
<body>
<%- include('partials/topnav', { user: user }) %>

<div class="wrap">
  <a href="/profile" class="back-btn">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
    Profilə qayıt
  </a>
  <div class="page-title">Şifrəni dəyiş</div>

  <% if (error)   { %><div class="error-msg"><%= error   %></div><% } %>
  <% if (success) { %><div class="success-msg"><%= success %></div><% } %>

  <div class="form-section">
    <% if (typeof step !== 'undefined' && step === 'verify') { %>
      <!-- ══════ ADDIM 2 · E-poçt təsdiq kodu (2FA) ══════ -->
      <div class="step-badge">ADDIM 2 / 2 · E-POÇT TƏSDİQİ</div>
      <div class="mail-note">
        Təhlükəsizlik üçün <b><%= maskedEmail %></b> ünvanına 6 rəqəmli təsdiq kodu göndərdik.
        Kodu daxil etmədən şifrəniz DƏYİŞMİR.
      </div>

      <form method="POST" action="/profile/changepass/verify" id="codeForm">
        <label class="form-label">Təsdiq kodu</label>
        <input type="hidden" name="code" id="codeValue">
        <div class="code-box">
          <input class="cd" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code">
          <input class="cd" type="text" inputmode="numeric" maxlength="1">
          <input class="cd" type="text" inputmode="numeric" maxlength="1">
          <input class="cd" type="text" inputmode="numeric" maxlength="1">
          <input class="cd" type="text" inputmode="numeric" maxlength="1">
          <input class="cd" type="text" inputmode="numeric" maxlength="1">
        </div>
        <div class="timer" id="timer" data-left="<%= secondsLeft %>">Kodun etibarlılıq müddəti: <b>--:--</b></div>
        <button type="submit" class="btn-save" style="margin-top:14px;">Təsdiqlə və şifrəni dəyiş</button>
      </form>

      <div class="row-2">
        <form method="POST" action="/profile/changepass/resend" style="flex:1;">
          <button type="submit" class="btn-ghost">Yeni kod göndər</button>
        </form>
        <form method="POST" action="/profile/changepass/cancel" style="flex:1;">
          <button type="submit" class="btn-ghost">Ləğv et</button>
        </form>
      </div>
    <% } else { %>
      <!-- ══════ ADDIM 1 · Şifrələr ══════ -->
      <div class="step-badge">ADDIM 1 / 2 · YENİ ŞİFRƏ</div>
      <form method="POST" action="/profile/changepass">
        <div class="form-group">
          <label class="form-label">Köhnə şifrə</label>
          <div class="pwd-wrap">
            <input class="form-input" type="password" name="oldpass" id="p1" placeholder="Mövcud şifrəniz" required autocomplete="current-password">
            <button type="button" class="eye-btn" onclick="togglePwd('p1','i1')">
              <svg id="i1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Yeni şifrə (min. 6 simvol)</label>
          <div class="pwd-wrap">
            <input class="form-input" type="password" name="newpass" id="p2" placeholder="Yeni şifrəniz" minlength="6" required autocomplete="new-password">
            <button type="button" class="eye-btn" onclick="togglePwd('p2','i2')">
              <svg id="i2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Yeni şifrəni təsdiqlə</label>
          <div class="pwd-wrap">
            <input class="form-input" type="password" name="newpass2" id="p3" placeholder="Yeni şifrəni təkrarlayın" minlength="6" required autocomplete="new-password">
            <button type="button" class="eye-btn" onclick="togglePwd('p3','i3')">
              <svg id="i3" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-save">E-poçta təsdiq kodu göndər</button>
      </form>
    <% } %>

    <div class="help-text">
      ⓘ Şifrə dəyişikliyi e-poçt təsdiqi (2FA) tələb edir. Şifrəniz heç vaxt e-poçt və ya Telegram vasitəsilə soruşulmur.
    </div>
  </div>
</div>

<%- include('partials/footer', { activePage: 'profile' }) %>

<script>
/* ── 2FA kod xanaları ── */
(function(){
  var boxes = document.querySelectorAll('.code-box .cd');
  var hidden = document.getElementById('codeValue');
  if (!boxes.length || !hidden) return;
  function sync(){
    var v = ''; boxes.forEach(function(b){ v += (b.value || '').replace(/\D/g,''); });
    hidden.value = v;
  }
  boxes.forEach(function(b, i){
    b.addEventListener('input', function(){
      b.value = (b.value || '').replace(/\D/g,'').slice(0,1);
      if (b.value && boxes[i+1]) boxes[i+1].focus();
      sync();
    });
    b.addEventListener('keydown', function(e){
      if (e.key === 'Backspace' && !b.value && boxes[i-1]) boxes[i-1].focus();
    });
    b.addEventListener('paste', function(e){
      var d = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g,'').slice(0,6);
      if (!d) return;
      e.preventDefault();
      for (var k = 0; k < boxes.length; k++) boxes[k].value = d[k] || '';
      sync();
      (boxes[Math.min(d.length, boxes.length - 1)]).focus();
    });
  });
  if (boxes[0]) boxes[0].focus();

  var t = document.getElementById('timer');
  if (t) {
    var left = parseInt(t.dataset.left, 10) || 0;
    (function tick(){
      if (left <= 0){ t.innerHTML = 'Kodun vaxtı bitdi — <b>yeni kod göndərin</b>'; return; }
      var m = Math.floor(left / 60), s2 = left % 60;
      t.innerHTML = 'Kodun etibarlılıq müddəti: <b>' + m + ':' + (s2 < 10 ? '0' : '') + s2 + '</b>';
      left--; setTimeout(tick, 1000);
    })();
  }
})();

function togglePwd(id,icId){
  const i=document.getElementById(id), ic=document.getElementById(icId);
  const show=i.type==='password';
  i.type = show ? 'text' : 'password';
  ic.innerHTML = show
    ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>'
    : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
}
</script>
</body>
</html>
