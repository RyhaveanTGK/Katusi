<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Birloto.com — Tombala</title>
<link rel="stylesheet" href="/assets/css/loto.css">
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Symbols+Outlined">
<style>
.lobby-wrap { padding: 14px 12px 130px; max-width: 480px; margin: 0 auto; }
.brand-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 4px 18px; }
.brand-logo { font-size: 30px; font-weight: 900; color: #fff; letter-spacing: -1px; }
.brand-logo .red { color: #e30613; }
.balance-pill { background: #4d1c7d; border-radius: 22px; padding: 9px 14px; color: #fff; font-weight: 800; font-size: 14px; }
.section-title { color: rgba(255,255,255,.7); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; padding: 4px 6px 10px; }
.room-card { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); border-radius: 16px; padding: 14px; margin-bottom: 11px; }
.room-card-top { display:flex; align-items:center; justify-content: space-between; gap: 10px; }
.room-card-title { font-size: 17px; font-weight: 900; color: #fff; }
.room-status { display: inline-flex; align-items: center; gap: 6px; background: rgba(245,197,24,.18); color: #f5c518; padding: 5px 11px; border-radius: 99px; font-size: 12px; font-weight: 800; }
.room-status.live { background: rgba(76,224,110,.18); color: #4ce07a; }
.status-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; animation: blink 1.2s infinite; }
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.room-meta { display:flex; justify-content: space-between; margin-top: 10px; color: rgba(255,255,255,.7); font-size: 13px; }
.room-meta b { color: #f5c518; font-weight: 800; font-size: 17px; }
.room-actions { display:flex; gap: 8px; margin-top: 12px; }
.btn-primary { flex: 1; background: linear-gradient(180deg,#5a90ee,#3f6fd4); color:#fff; border:none; border-radius: 12px; padding: 11px 14px; font-weight: 800; cursor: pointer; font-size: 14px; text-decoration:none; text-align:center; }
.btn-secondary { flex: 0 0 auto; background: rgba(255,255,255,.12); color:#fff; border:none; border-radius: 12px; padding: 11px 14px; font-weight: 800; cursor: pointer; font-size: 14px; text-decoration:none; text-align:center; }
.auth-row { display:flex; gap: 8px; }
.auth-link { color: #f5c518; font-weight: 800; font-size: 13px; text-decoration: none; }
.user-chip { display:flex; align-items:center; gap: 8px; text-align:right; }
.user-chip .av { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(180deg,#ffd54a,#c8960c); color:#2b1200; font-weight: 900; display:flex; align-items:center; justify-content:center; font-size: 13px; }
.user-chip .name { color:#fff; font-weight: 800; font-size: 13px; }
</style>
</head>
<body>
<div class="lobby-wrap">
  <div class="brand-row">
    <div class="brand-logo"><span class="red">Bir</span>loto.com</div>
    <% if (user) { %>
      <a class="user-chip" href="/profile" style="text-decoration:none">
        <div class="av"><%= user.username.slice(0,2).toUpperCase() %></div>
        <div>
          <div class="name"><%= user.username %></div>
          <div class="balance-pill">Balans: <%= (user.balance||0).toFixed(2) %> ₼</div>
        </div>
      </a>
    <% } else { %>
      <div class="auth-row"><a class="auth-link" href="/login">Giriş</a><a class="auth-link" href="/register">Qeydiyyat</a></div>
    <% } %>
  </div>
  <div class="section-title">Canlı otaqlar</div>
  <% if (!user) { %>
    <div class="room-card">
      <div class="room-card-title">Giriş tələb olunur</div>
      <div class="room-meta">Bilet almaq üçün hesabınıza daxil olun.</div>
      <div class="room-actions">
        <a class="btn-primary" href="/login">Giriş et</a>
        <a class="btn-secondary" href="/register">Qeydiyyat</a>
      </div>
    </div>
  <% } %>
  <% rooms.forEach(function(r){ %>
    <div class="room-card">
      <div class="room-card-top">
        <div class="room-card-title"><%= r.name %></div>
        <div class="room-status <%= r.status==='started'?'live':'' %>">
          <span class="status-dot"></span>
          <%= r.status==='started'?'CANLI':(r.status==='ended'?'BİTİB':'GÖZLƏYİR') %>
        </div>
      </div>
      <div class="room-meta">
        <span>Bilet: <b><%= r.entryFee.toFixed(2) %> ₼</b></span>
        <span>Limit: <b><%= r.maxPlayers %></b></span>
        <span>Mərc: <b><%= (r.basePot||r.stakeTotal||0).toFixed(2) %> ₼</b></span>
      </div>
      <div class="room-actions">
        <% if (user) { %>
          <a class="btn-primary" href="/rooms/<%= r._id %>/lobby">Daxil ol</a>
        <% } else { %>
          <a class="btn-primary" href="/login">Oyna</a>
        <% } %>
      </div>
    </div>
  <% }); %>
</div>
</body>
</html>
