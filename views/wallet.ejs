<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#3d0d62">
<title>Balans – One Loto</title>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<style>
*{ box-sizing:border-box; margin:0; padding:0; }
::-webkit-scrollbar{ display:none; }
html,body{ overflow-x:hidden; }
body{
  background:#3d0d62; color:#fff;
  font-family:'Rubik','Segoe UI',Tahoma,Arial,sans-serif;
  min-height:100vh; padding-top:72px; padding-bottom:24px;
}
.wrap{ width:100%; max-width:430px; margin:0 auto; padding:14px 14px 30px; }
.page-title{ font-size:22px; font-weight:900; }
.page-sub{ font-size:13px; color:rgba(255,255,255,.55); margin-bottom:16px; }

.balance-card{
  background: linear-gradient(135deg,#7a2db0,#4b1478);
  border:1px solid rgba(245,197,24,.25);
  border-radius:20px; padding:18px; margin-bottom:16px;
}
.balance-lbl{ font-size:11px; text-transform:uppercase; letter-spacing:.6px; color:rgba(255,255,255,.65); font-weight:700; }
.balance-val{ font-size:32px; font-weight:900; color:#f5c518; margin-top:4px; }
.balance-meta{ display:flex; gap:14px; margin-top:10px; font-size:12px; color:rgba(255,255,255,.7); }

.lang-row{ display:flex; gap:6px; margin-bottom:14px; flex-wrap:wrap; }
.lang-chip{
  text-decoration:none; font-size:12px; font-weight:700;
  padding:7px 12px; border-radius:99px;
  background: rgba(255,255,255,.08); color:rgba(255,255,255,.7);
  border:1px solid rgba(255,255,255,.14);
}
.lang-chip.on{ background:#f5c518; color:#3d2200; border-color:#f5c518; }

.tab-row{ display:flex; border-radius:14px; overflow:hidden; border:1px solid rgba(255,255,255,.15); margin-bottom:16px; }
.tab-btn{ flex:1; padding:12px; font-size:13px; font-weight:800; border:none; cursor:pointer;
  background: rgba(255,255,255,.07); color:rgba(255,255,255,.7); font-family:inherit; }
.tab-btn.active{ background:#5c2491; color:#fff; }

.msg{ border-radius:12px; padding:11px 14px; font-size:13px; font-weight:600; margin-bottom:14px; }
.msg.ok{ background:rgba(28,184,93,.16); border:1px solid rgba(28,184,93,.4); color:#7bf0ae; }
.msg.err{ background:rgba(232,0,26,.15); border:1px solid rgba(232,0,26,.35); color:#ff9a9a; }

.section-title{ font-size:13px; font-weight:800; color:rgba(255,255,255,.75); margin:16px 0 10px; }

.methods{ display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
.method{
  display:flex; align-items:center; gap:10px;
  background: rgba(255,255,255,.06);
  border:1.5px solid rgba(255,255,255,.12);
  border-radius:16px; padding:11px; cursor:pointer;
  transition: border-color .15s, background .15s;
}
.method:hover{ background: rgba(255,255,255,.1); }
.method.sel{ border-color:#f5c518; background: rgba(245,197,24,.12); }
.method img{ width:38px; height:38px; border-radius:11px; flex:0 0 auto; }
.method .mn{ font-size:12.5px; font-weight:800; line-height:1.2; }
.method .mk{ font-size:10.5px; color:rgba(255,255,255,.5); margin-top:2px; }
.method input{ display:none; }

.detail-box{
  margin-top:14px; background: rgba(0,0,0,.22);
  border:1px dashed rgba(245,197,24,.4); border-radius:14px; padding:12px 14px;
}
.detail-box .dl{ font-size:11px; color:rgba(255,255,255,.55); text-transform:uppercase; letter-spacing:.4px; }
.detail-box .dv{ font-size:15px; font-weight:800; font-family:monospace; letter-spacing:.6px; word-break:break-all; }
.detail-box .row{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:8px; }
.copy-btn{ background:#f5c518; color:#3d2200; border:none; border-radius:9px; padding:7px 11px; font-weight:800; font-size:11px; cursor:pointer; font-family:inherit; }
.no-details{ font-size:12px; color:rgba(255,255,255,.6); }

.field{ margin-top:12px; }
.field label{ display:block; font-size:12px; font-weight:700; color:rgba(255,255,255,.7); margin-bottom:6px; }
.field input, .field select{
  width:100%; padding:12px 14px; border-radius:12px;
  background: rgba(0,0,0,.25); border:1px solid rgba(255,255,255,.15);
  color:#fff; font-size:14px; font-weight:600; font-family:inherit;
}
.field input::placeholder{ color:rgba(255,255,255,.35); }
.quick{ display:flex; gap:8px; flex-wrap:wrap; margin-top:8px; }
.quick button{
  background: rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.16);
  color:#fff; border-radius:10px; padding:7px 12px; font-size:12px; font-weight:800; cursor:pointer; font-family:inherit;
}
.submit-btn{
  width:100%; margin-top:16px; padding:15px;
  background: linear-gradient(180deg,#f5c518,#c8960c); color:#3d2200;
  border:none; border-radius:14px; font-size:15px; font-weight:900;
  cursor:pointer; font-family:inherit; text-transform:uppercase; letter-spacing:.4px;
}
.submit-btn.alt{ background: linear-gradient(180deg,#4d86e8,#3f6fd4); color:#fff; }
.submit-btn:disabled{ opacity:.5; cursor:not-allowed; }

.tx{ display:flex; align-items:center; gap:10px; background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.08); border-radius:12px; padding:11px 13px; margin-bottom:8px; }
.tx .ti{ font-size:20px; }
.tx .tb{ flex:1; min-width:0; }
.tx .tn{ font-size:13px; font-weight:800; }
.tx .td{ font-size:11px; color:rgba(255,255,255,.45); margin-top:2px; }
.tx .ta{ font-size:14px; font-weight:900; }
.ta.plus{ color:#1cb85d; } .ta.minus{ color:#ff7b7b; }
.badge{ font-size:9.5px; font-weight:800; border-radius:6px; padding:2px 7px; }
.b-pending{ background:#fff3cd; color:#856404; }
.b-completed{ background:#d4edda; color:#155724; }
.b-rejected{ background:#f8d7da; color:#721c24; }
.empty{ text-align:center; padding:26px; color:rgba(255,255,255,.4); font-size:13px; }
.hidden{ display:none !important; }
.locale-note{ display:flex; gap:10px; align-items:flex-start; background:rgba(92,36,145,.18);
  border:1px solid rgba(255,255,255,.14); border-radius:12px; padding:10px 12px; margin-bottom:14px;
  font-size:12px; line-height:1.5; color:rgba(255,255,255,.8); }
.locale-note .lf{ font-size:18px; line-height:1; }
.locale-note b{ color:#f5c518; }
.info-note{ background:rgba(0,0,0,.22); border:1px dashed rgba(255,255,255,.2); border-radius:12px;
  padding:11px 13px; margin-bottom:12px; font-size:12px; line-height:1.55; color:rgba(255,255,255,.72); }
.info-note b{ color:#f5c518; }
.card-brand{ display:flex; align-items:center; gap:8px; min-height:22px; margin-top:6px; font-size:12px; font-weight:800; color:rgba(255,255,255,.6); }
.card-brand .bp{ background:#f5c518; color:#1a0b2e; border-radius:6px; padding:3px 9px; font-size:11px; font-weight:900; letter-spacing:.5px; }
.two-col{ display:flex; gap:10px; }
.two-col .field{ flex:1; }
.limit-line{ font-size:11.5px; color:rgba(255,255,255,.55); margin-top:6px; }
.limit-line b{ color:#f5c518; }
@supports (padding: max(0px)) { body{ padding-top: max(72px, calc(72px + env(safe-area-inset-top))); } }
</style>
</head>
<body>
<%- include('partials/topnav', { user: user }) %>

<div class="wrap">
  <div class="page-title">💳 <%= t('wallet.title') %></div>
  <div class="page-sub"><%= t('wallet.sub') %></div>

  <div class="balance-card">
    <div class="balance-lbl"><%= t('wallet.balance') %></div>
    <div class="balance-val"><%= money(user.balance || 0) %></div>
    <div class="balance-meta">
      <span>⬆ <%= t('wallet.deposits') %>: <b><%= money(counter.totalDeposits || 0) %></b></span>
      <span>⬇ <%= t('wallet.withdraws') %>: <b><%= money(counter.totalWithdraws || 0) %></b></span>
    </div>
  </div>

  <!-- İstifadəçi ölkə/valyuta SEÇMİR: aktiv interfeys dilinə uyğun rekvizitlər göstərilir -->
  <div class="locale-note">
    <span class="lf"><%= localeMeta.flag %></span>
    <span>Əməliyyatlar <b><%= localeMeta.native %></b> bölgəsinə uyğun aparılır · Valyuta: <b><%= localeMeta.currency %></b>.
    Dili dəyişsəniz balans və bank rekvizitləri avtomatik həmin valyutaya keçir.</span>
  </div>

  <% if (success) { %><div class="msg ok"><%= success %></div><% } %>
  <% if (error)   { %><div class="msg err"><%= error %></div><% } %>

  <div class="tab-row">
    <button type="button" class="tab-btn <%= tab === 'withdraw' ? '' : 'active' %>" id="tabDepositBtn" onclick="showTab('deposit')"><%= t('wallet.tab_deposit') %></button>
    <button type="button" class="tab-btn <%= tab === 'withdraw' ? 'active' : '' %>" id="tabWithdrawBtn" onclick="showTab('withdraw')"><%= t('wallet.tab_withdraw') %></button>
  </div>

  <!-- ══════ DEPOZİT ══════ -->
  <div id="tab-deposit" class="<%= tab === 'withdraw' ? 'hidden' : '' %>">
    <% if (!depositMethods.length) { %>
      <div class="empty"><%= t('wallet.no_methods') %></div>
    <% } else { %>
    <form method="POST" action="/wallet/deposit" enctype="multipart/form-data" id="depositForm">
      <input type="hidden" name="lang" value="<%= locale %>">
      <input type="hidden" name="method" id="depMethod" value="">

      <div class="section-title"><%= t('wallet.choose_method') %></div>
      <div class="methods">
        <% depositMethods.forEach(function(m){ %>
        <label class="method" data-key="<%= m.key %>" data-kind="<%= m.kind %>"
               data-card="<%= m.cardNumber || '' %>" data-iban="<%= m.iban || '' %>"
               data-holder="<%= m.accountHolder || '' %>" data-wallet="<%= m.walletAddress || '' %>"
               data-phone="<%= m.phone || '' %>" data-network="<%= m.network || '' %>"
               data-min="<%= ((m.minAmount != null ? m.minAmount : limits.depositMin) * localeMeta.rate).toFixed(2) %>"
               data-max="<%= ((m.maxAmount != null ? m.maxAmount : limits.depositMax) * localeMeta.rate).toFixed(2) %>"
               data-name="<%= m.name %>">
          <img src="<%= m.logo || '/assets/banks/banktransfer.svg' %>" alt="<%= m.name %>">
          <div>
            <div class="mn"><%= m.name %></div>
            <div class="mk"><%= m.currency %><%= m.network ? ' · ' + m.network : '' %></div>
          </div>
          <input type="radio" name="__dep" value="<%= m.key %>">
        </label>
        <% }); %>
      </div>

      <div class="detail-box" id="depDetails">
        <div class="no-details"><%= t('wallet.details_hint') %></div>
      </div>

      <div class="field">
        <label><%= t('wallet.amount') %> (<%= money(limits.depositMin, { symbol:false }) %> – <%= money(limits.depositMax, { symbol:false }) %> <%= localeMeta.symbol %>)</label>
        <input type="number" name="amount" id="depAmount" step="0.01" min="<%= (limits.depositMin * localeMeta.rate).toFixed(2) %>" max="<%= (limits.depositMax * localeMeta.rate).toFixed(2) %>" placeholder="0.00" required>
        <div class="limit-line" id="depLimitLine"></div>
        <div class="quick">
          <button type="button" onclick="setAmt('depAmount',<%= Math.round(10 * localeMeta.rate) %>)"><%= Math.round(10 * localeMeta.rate) %></button>
          <button type="button" onclick="setAmt('depAmount',<%= Math.round(20 * localeMeta.rate) %>)"><%= Math.round(20 * localeMeta.rate) %></button>
          <button type="button" onclick="setAmt('depAmount',<%= Math.round(50 * localeMeta.rate) %>)"><%= Math.round(50 * localeMeta.rate) %></button>
          <button type="button" onclick="setAmt('depAmount',<%= Math.round(100 * localeMeta.rate) %>)"><%= Math.round(100 * localeMeta.rate) %></button>
        </div>
      </div>

      <div class="info-note" id="depBankFields">
        🔒 <%= pay.correctInformationMessage %><br>
        <span style="opacity:.85"><%= pay.step1 %> · <%= pay.step3 %></span>
      </div>

      <div class="field">
        <label><%= t('wallet.receipt') %></label>
        <div style="font-size:11.5px;color:rgba(255,255,255,.45);margin:4px 0 6px;line-height:1.45;"><%= t('wallet.receipt_hint') %></div>
        <input type="file" name="receipt" accept="image/*,application/pdf">
      </div>

      <button type="submit" class="submit-btn" id="depSubmit"><%= t('wallet.submit_deposit') %></button>
    </form>

    <!-- Kripto formu ayrıca göndərilir -->
    <form method="POST" action="/wallet/deposit/crypto" enctype="multipart/form-data" id="cryptoForm" class="hidden">
      <input type="hidden" name="lang" value="<%= locale %>">
      <input type="hidden" name="method" id="cryMethod" value="">
      <div class="field">
        <label><%= t('wallet.amount') %></label>
        <input type="number" name="amount" id="cryAmount" step="0.01" min="<%= (limits.depositMin * localeMeta.rate).toFixed(2) %>" placeholder="0.00">
      </div>
      <div class="field">
        <label><%= t('wallet.wallet_address') %></label>
        <input type="text" name="walletAddress" placeholder="0x... / T...">
      </div>
      <div class="field">
        <label><%= t('wallet.receipt') %></label>
        <input type="file" name="receipt" accept="image/*,application/pdf">
      </div>
      <button type="submit" class="submit-btn"><%= t('wallet.submit_deposit') %></button>
    </form>
    <% } %>
  </div>

  <!-- ══════ ÇIXARIŞ ══════ -->
  <div id="tab-withdraw" class="<%= tab === 'withdraw' ? '' : 'hidden' %>">
    <% if (!withdrawMethods.length) { %>
      <div class="empty"><%= t('wallet.no_methods') %></div>
    <% } else { %>
    <form method="POST" action="/wallet/withdraw" id="withdrawForm">
      <input type="hidden" name="lang" value="<%= locale %>">
      <input type="hidden" name="method" id="wdMethod" value="">

      <div class="section-title"><%= bankGroupTitle %></div>
      <div class="methods">
        <% withdrawMethods.forEach(function(m){ %>
        <label class="method wd" data-key="<%= m.key %>" data-kind="<%= m.kind %>" data-name="<%= m.name %>"
               data-min="<%= ((m.withdrawMin != null ? m.withdrawMin : limits.withdrawMin) * localeMeta.rate).toFixed(2) %>"
               data-max="<%= ((m.withdrawMax != null ? m.withdrawMax : limits.withdrawMax) * localeMeta.rate).toFixed(2) %>">
          <img src="<%= m.logo || '/assets/banks/banktransfer.svg' %>" alt="<%= m.name %>">
          <div>
            <div class="mn"><%= m.name %></div>
            <div class="mk"><%= m.currency %><%= m.network ? ' · ' + m.network : '' %></div>
          </div>
          <input type="radio" name="__wd" value="<%= m.key %>">
        </label>
        <% }); %>
      </div>

      <div class="field">
        <label><%= t('wallet.amount') %> (<%= money(limits.withdrawMin, { symbol:false }) %> – <%= money(limits.withdrawMax, { symbol:false }) %> <%= localeMeta.symbol %>)</label>
        <input type="number" name="amount" id="wdAmount" step="0.01" min="<%= (limits.withdrawMin * localeMeta.rate).toFixed(2) %>" max="<%= (limits.withdrawMax * localeMeta.rate).toFixed(2) %>" placeholder="0.00" required>
        <div class="limit-line" id="wdLimitLine"></div>
      </div>

      <div id="wdBankFields">
        <div class="info-note">
          💳 <b><%= pay.commissionMessage %></b><br>
          <%= pay.correctInformationMessage %><br>
          <span style="opacity:.8"><%= pay.bankMessage %></span>
        </div>
        <div class="info-note" id="wdCalc" style="display:none"></div>
        <div class="field">
          <label><%= t('wallet.card_number') %></label>
          <input type="text" name="cardNumber" id="wdCard" inputmode="numeric" autocomplete="off"
                 placeholder="<%= pay.cardNumberPlaceholder %>" maxlength="23">
          <div class="card-brand" id="wdBrand"><span><%= pay.selectCardType %></span></div>
        </div>
        <div class="two-col">
          <div class="field">
            <label><%= pay.expiryDate %></label>
            <input type="text" name="cardExpiry" id="wdExp" inputmode="numeric" placeholder="MM/YY" maxlength="5" autocomplete="off">
          </div>
          <div class="field">
            <label><%= pay.cvv %></label>
            <input type="password" name="cvv" id="wdCvv" inputmode="numeric" placeholder="•••" maxlength="4" autocomplete="off">
          </div>
        </div>
        <div class="field">
          <label><%= t('wallet.holder') %></label>
          <input type="text" name="cardHolder" id="wdHolder" placeholder="<%= pay.namePlaceholder %>" autocomplete="off">
        </div>
      </div>

      <div id="wdCryptoFields" class="hidden">
        <div class="field">
          <label><%= t('wallet.wallet_address') %></label>
          <input type="text" name="walletAddress" placeholder="0x... / T...">
        </div>
      </div>

      <button type="submit" class="submit-btn alt"><%= t('wallet.submit_withdraw') %></button>
    </form>
    <% } %>
  </div>

  <div class="section-title"><%= t('wallet.history') %></div>
  <% if (!transactions.length) { %>
    <div class="empty"><%= t('wallet.empty_history') %></div>
  <% } %>
  <% const tr = t; %>
  <% transactions.forEach(function(t){ %>
  <div class="tx">
    <div class="ti"><%= t.type === 'deposit' ? '⬆️' : t.type === 'withdraw' ? '⬇️' : '🎁' %></div>
    <div class="tb">
      <div class="tn"><%= t.type === 'deposit' ? tr('wallet.deposits') : t.type === 'withdraw' ? tr('wallet.withdraws') : t.type %>
        <span class="badge b-<%= t.status %>"><%= t.status === 'pending' ? tr('wallet.pending') : t.status === 'completed' ? tr('wallet.completed') : tr('wallet.rejected') %></span>
      </div>
      <div class="td"><%= new Date(t.createdAt).toLocaleString(localeMeta.intl || 'en-US') %><%= t.method ? ' · ' + t.method : '' %></div>
    </div>
    <div class="ta <%= t.type === 'withdraw' ? 'minus' : 'plus' %>"><%= t.type === 'withdraw' ? '-' : '+' %><%= money(t.amount) %></div>
  </div>
  <% }); %>
</div>

<%- include('partials/footer', { activePage: 'wallet' }) %>

<script>
var PAYTXT = <%- JSON.stringify(pay) %>;
var CUR = '<%= localeMeta.symbol %>';
function wdRecalc(){
  var el = document.getElementById('wdAmount');
  var box = document.getElementById('wdCalc');
  if (!el || !box) return;
  var v = parseFloat(el.value || '0');
  if (!v || v <= 0){ box.style.display = 'none'; return; }
  var net = Math.round(v * 0.95 * 100) / 100;
  box.style.display = 'block';
  box.innerHTML = '💸 ' + PAYTXT.withdrawCardAmount.replace('{{amount}}', '<b>' + net.toFixed(2) + ' ' + CUR + '</b>')
    + '<br>' + PAYTXT.withdrawBalanceReturn.replace('{{amount}}', '<b>' + v.toFixed(2) + ' ' + CUR + '</b>');
}
document.addEventListener('DOMContentLoaded', function(){
  var el = document.getElementById('wdAmount');
  if (el) el.addEventListener('input', wdRecalc);
});
function showTab(t){
  document.getElementById('tab-deposit').classList.toggle('hidden', t !== 'deposit');
  document.getElementById('tab-withdraw').classList.toggle('hidden', t !== 'withdraw');
  document.getElementById('tabDepositBtn').classList.toggle('active', t === 'deposit');
  document.getElementById('tabWithdrawBtn').classList.toggle('active', t === 'withdraw');
}
function setAmt(id, v){ document.getElementById(id).value = v; }
var COPY_LBL = <%- JSON.stringify(t('wallet.copy')) %>;
var CUR = <%- JSON.stringify(localeMeta.symbol || localeMeta.currency) %>;
function copyTxt(v){
  navigator.clipboard && navigator.clipboard.writeText(v);
  alert(<%- JSON.stringify(t('wallet.copied')) %> + ' ' + v);
}

/* ── Depozit üsulu seçimi ── */
document.querySelectorAll('#tab-deposit .method').forEach(function(el){
  el.addEventListener('click', function(){
    document.querySelectorAll('#tab-deposit .method').forEach(function(x){ x.classList.remove('sel'); });
    el.classList.add('sel');
    var d = el.dataset;
    var isCrypto = d.kind === 'crypto';
    document.getElementById('depMethod').value = d.key;
    document.getElementById('cryMethod').value = d.key;

    document.getElementById('depositForm').classList.toggle('hidden', false);
    document.getElementById('depBankFields').classList.toggle('hidden', isCrypto);
    document.getElementById('depAmount').required = !isCrypto;
    document.getElementById('depSubmit').classList.toggle('hidden', isCrypto);
    document.getElementById('cryptoForm').classList.toggle('hidden', !isCrypto);

    var da = document.getElementById('depAmount');
    if (d.min) da.min = d.min;
    if (d.max) da.max = d.max;
    document.getElementById('depLimitLine').innerHTML =
      'Minimum: <b>' + d.min + ' ' + CUR + '</b> · Maksimum: <b>' + d.max + ' ' + CUR + '</b>';

    var box = document.getElementById('depDetails');
    var rows = [];
    if (isCrypto) {
      if (d.wallet) rows.push([<%- JSON.stringify(t('wallet.wallet_address')) %>, d.wallet]);
      if (d.network) rows.push([<%- JSON.stringify(t('wallet.network')) %>, d.network]);
    } else {
      if (d.card) rows.push([<%- JSON.stringify(t('wallet.card_number')) %>, d.card]);
      if (d.iban) rows.push(['IBAN', d.iban]);
      if (d.holder) rows.push([<%- JSON.stringify(t('wallet.holder')) %>, d.holder]);
      if (d.phone) rows.push(['Telefon', d.phone]);
    }
    if (!rows.length){
      box.innerHTML = '<div class="no-details">' + d.name + ' üçün rekvizitlər admin tərəfindən hələ əlavə edilməyib.</div>';
      return;
    }
    box.innerHTML = rows.map(function(r){
      return '<div class="row"><div><div class="dl">' + r[0] + '</div><div class="dv">' + r[1] + '</div></div>' +
             '<button type="button" class="copy-btn" data-copy="' + r[1] + '">' + COPY_LBL + '</button></div>';
    }).join('');
    box.querySelectorAll('.copy-btn').forEach(function(b){
      b.addEventListener('click', function(){ copyTxt(b.dataset.copy); });
    });
  });
});

/* ── Çıxarış üsulu seçimi ── */
document.querySelectorAll('#tab-withdraw .method').forEach(function(el){
  el.addEventListener('click', function(){
    document.querySelectorAll('#tab-withdraw .method').forEach(function(x){ x.classList.remove('sel'); });
    el.classList.add('sel');
    document.getElementById('wdMethod').value = el.dataset.key;
    var isCrypto = el.dataset.kind === 'crypto';
    var wa = document.getElementById('wdAmount');
    if (el.dataset.min) wa.min = el.dataset.min;
    if (el.dataset.max) wa.max = el.dataset.max;
    document.getElementById('wdLimitLine').innerHTML =
      'Minimum çıxarış: <b>' + el.dataset.min + ' ' + CUR + '</b> · Maksimum: <b>' + el.dataset.max + ' ' + CUR + '</b>';
    document.getElementById('wdBankFields').classList.toggle('hidden', isCrypto);
    document.getElementById('wdCryptoFields').classList.toggle('hidden', !isCrypto);
  });
});

/* ── Kart nömrəsi maskası və AVTOMATİK brend təyini ── */
function brandOf(num){
  var n = String(num || '').replace(/\D/g,'');
  if (/^4/.test(n)) return 'VISA';
  if (/^(5[1-5]|2(2[2-9]|[3-6]\d|7[01]|720))/.test(n)) return 'MASTERCARD';
  if (/^3[47]/.test(n)) return 'AMERICAN EXPRESS';
  if (/^(6011|65|64[4-9])/.test(n)) return 'DISCOVER';
  if (/^(60|65|81|82)/.test(n) && n.length >= 6) return 'RUPAY';
  if (/^(2200|2201|2202|2203|2204)/.test(n)) return 'MIR';
  if (/^(9792|4098)/.test(n)) return 'TROY';
  return '';
}
function luhnOk(num){
  var n = String(num || '').replace(/\D/g,'');
  if (n.length < 13 || n.length > 19) return false;
  var sum = 0, alt = false;
  for (var i = n.length - 1; i >= 0; i--){
    var d = parseInt(n[i], 10);
    if (alt){ d *= 2; if (d > 9) d -= 9; }
    sum += d; alt = !alt;
  }
  return sum % 10 === 0;
}
var wdCard = document.getElementById('wdCard');
if (wdCard) {
  wdCard.addEventListener('input', function(){
    var n = wdCard.value.replace(/\D/g,'').slice(0,19);
    wdCard.value = n.replace(/(.{4})/g,'$1 ').trim();
    var b = brandOf(n);
    var box = document.getElementById('wdBrand');
    if (!n) box.innerHTML = '<span>Kart tipi avtomatik təyin olunacaq</span>';
    else if (b) box.innerHTML = '<span class="bp">' + b + '</span><span>' + (luhnOk(n) ? '✓ nömrə etibarlıdır' : 'nömrəni tamamlayın…') + '</span>';
    else box.innerHTML = '<span>Kart tipi tanınmadı</span>';
  });
}
var wdExp = document.getElementById('wdExp');
if (wdExp) {
  wdExp.addEventListener('input', function(){
    var v = wdExp.value.replace(/\D/g,'').slice(0,4);
    wdExp.value = v.length > 2 ? v.slice(0,2) + '/' + v.slice(2) : v;
  });
}
var wdCvv = document.getElementById('wdCvv');
if (wdCvv) wdCvv.addEventListener('input', function(){ wdCvv.value = wdCvv.value.replace(/\D/g,'').slice(0,4); });

/* Üsul seçilmədən göndərişin qarşısını al */
var df = document.getElementById('depositForm');
if (df) df.addEventListener('submit', function(e){
  if (!document.getElementById('depMethod').value){ e.preventDefault(); alert('Əvvəlcə ödəniş üsulunu seçin'); }
});
var wf = document.getElementById('withdrawForm');
if (wf) wf.addEventListener('submit', function(e){
  if (!document.getElementById('wdMethod').value){ e.preventDefault(); alert('Əvvəlcə çıxarış üsulunu seçin'); return; }
  if (document.getElementById('wdBankFields').classList.contains('hidden')) return;
  var n = (document.getElementById('wdCard').value || '').replace(/\D/g,'');
  if (!luhnOk(n)) { e.preventDefault(); alert('Kart nömrəsi düzgün deyil'); return; }
  if (!/^\d{2}\/\d{2}$/.test(document.getElementById('wdExp').value || '')) { e.preventDefault(); alert('Son istifadə tarixini AA/İİ formatında yazın'); return; }
  var c = document.getElementById('wdCvv').value || '';
  if (c.length < 3) { e.preventDefault(); alert('CVV düzgün deyil'); return; }
  if ((document.getElementById('wdHolder').value || '').trim().split(/\s+/).filter(Boolean).length < 2) { e.preventDefault(); alert('Kart sahibinin ad və soyadını yazın'); }
});
</script>
</body>
</html>
