<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#3d0d62">
<title><%= pay.payTitle %> – One Loto</title>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{ box-sizing:border-box; margin:0; padding:0; }
::-webkit-scrollbar{ display:none; }
html,body{ overflow-x:hidden; }
body{
  background:#3d0d62; color:#fff;
  font-family:'Rubik','Segoe UI',Tahoma,Arial,sans-serif;
  min-height:100vh; padding-top:72px; padding-bottom:28px;
}
.wrap{ width:100%; max-width:430px; margin:0 auto; padding:14px 14px 40px; }
.page-title{ font-size:21px; font-weight:900; }
.page-sub{ font-size:12.5px; color:rgba(255,255,255,.6); margin:4px 0 16px; line-height:1.5; }

/* ── Kart (referans dizayn) ── */
.pcard{
  position:relative; border-radius:20px; padding:18px;
  background: linear-gradient(135deg,#1d4ed8,#312e81);
  box-shadow:0 18px 40px rgba(0,0,0,.35); overflow:hidden;
  aspect-ratio:1.586/1; display:flex; flex-direction:column; justify-content:space-between;
}
.pcard .blob{ position:absolute; border-radius:50%; background:#fff; opacity:.08; }
.pcard .b1{ width:220px; height:220px; top:-110px; right:-90px; }
.pcard .b2{ width:170px; height:170px; bottom:-90px; left:-70px; }
.pcard .brand{ position:relative; display:flex; justify-content:flex-end; font-size:22px; font-weight:900; letter-spacing:1px; font-style:italic; }
.pcard .mc{ display:flex; }
.pcard .mc i{ width:34px; height:34px; border-radius:50%; display:block; }
.pcard .mc i:first-child{ background:#eb001b; }
.pcard .mc i:last-child{ background:#f79e1b; margin-left:-16px; }
.pcard .lbl{ position:relative; font-size:10.5px; letter-spacing:.15em; text-transform:uppercase; color:rgba(255,255,255,.7); }
.pcard .row{ position:relative; display:flex; align-items:center; gap:8px; }
.pcard .pan{ flex:1; font-family:ui-monospace,Menlo,Consolas,monospace; font-size:18px; letter-spacing:1.5px; font-weight:700; }
.pcard .hold{ flex:1; font-size:15px; font-weight:800; text-transform:uppercase; letter-spacing:.5px; }
.icb{ background:rgba(255,255,255,.16); border:none; border-radius:9px; width:32px; height:32px; color:#fff; cursor:pointer; font-size:14px; }
.icb:hover{ background:rgba(255,255,255,.28); }

.panel{ background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:16px; padding:14px; margin-top:14px; }
.panel-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; }
.panel-title{ font-size:14px; font-weight:900; }
.timer{ font-size:13px; font-weight:900; color:#f5c518; font-variant-numeric:tabular-nums; }
.timer-lbl{ font-size:11px; color:rgba(255,255,255,.55); }

.steps{ list-style:none; display:flex; flex-direction:column; gap:10px; }
.steps li{ display:flex; gap:10px; align-items:flex-start; font-size:12.5px; line-height:1.5; color:rgba(255,255,255,.85); }
.steps .n{ flex:0 0 22px; height:22px; border-radius:50%; background:rgba(245,197,24,.18); border:1px solid rgba(245,197,24,.5);
  color:#f5c518; font-size:11px; font-weight:900; display:flex; align-items:center; justify-content:center; }
.steps li.done .n{ background:#1cb85d; border-color:#1cb85d; color:#fff; }

.amount-box{ display:flex; align-items:center; justify-content:space-between; gap:10px;
  background:rgba(0,0,0,.25); border:1px dashed rgba(245,197,24,.45); border-radius:14px; padding:12px 14px; margin-top:14px; }
.amount-box .al{ font-size:11px; text-transform:uppercase; letter-spacing:.5px; color:rgba(255,255,255,.6); }
.amount-box .av{ font-size:22px; font-weight:900; color:#f5c518; }

.txid{ display:flex; align-items:center; gap:8px; margin-top:12px; padding-top:12px; border-top:1px solid rgba(255,255,255,.1); }
.txid .k{ font-size:11px; color:rgba(255,255,255,.55); }
.txid .v{ flex:1; font-family:ui-monospace,Menlo,Consolas,monospace; font-size:12px; word-break:break-all; }

.alert{ border-radius:14px; padding:12px 14px; font-size:12.5px; line-height:1.55; margin-top:14px; border:1px solid; }
.alert b{ display:block; font-size:13.5px; margin-bottom:3px; }
.a-pending{ background:rgba(77,134,232,.14); border-color:rgba(77,134,232,.45); color:#cfe0ff; }
.a-ok{ background:rgba(28,184,93,.15); border-color:rgba(28,184,93,.45); color:#95f3bd; }
.a-err{ background:rgba(232,0,26,.14); border-color:rgba(232,0,26,.4); color:#ffb0b0; }
.a-warn{ background:rgba(255,152,0,.14); border-color:rgba(255,152,0,.4); color:#ffd39b; }

.btns{ display:flex; flex-direction:column; gap:10px; margin-top:16px; }
.btn{ width:100%; padding:15px; border:none; border-radius:14px; font-size:15px; font-weight:900;
  cursor:pointer; font-family:inherit; letter-spacing:.3px; }
.btn-primary{ background:linear-gradient(180deg,#4d86e8,#2f5fc8); color:#fff; }
.btn-danger{ background:transparent; border:2px solid #e8434f; color:#ff9b9b; }
.btn:disabled{ opacity:.55; cursor:not-allowed; }
.btn-ghost{ background:rgba(255,255,255,.1); color:#fff; border:1px solid rgba(255,255,255,.18); }

.file-row{ margin-top:14px; }
.file-row label{ display:block; font-size:12px; font-weight:700; color:rgba(255,255,255,.7); margin-bottom:6px; }
.file-row input[type=file]{ width:100%; font-size:12px; color:rgba(255,255,255,.75); }

.toast{ position:fixed; top:14px; left:50%; transform:translateX(-50%); z-index:99;
  background:#fff; color:#12203a; border-radius:12px; padding:11px 16px; font-size:13px; font-weight:800;
  box-shadow:0 12px 30px rgba(0,0,0,.35); display:none; }

.modal{ position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:120; display:none; align-items:center; justify-content:center; padding:18px; }
.modal.on{ display:flex; }
.modal-box{ width:100%; max-width:340px; background:#2a0947; border:1px solid rgba(255,255,255,.14); border-radius:18px; padding:18px; }
.modal-box h3{ font-size:16px; font-weight:900; margin-bottom:6px; }
.modal-box p{ font-size:12.5px; color:rgba(255,255,255,.7); line-height:1.5; margin-bottom:14px; }
.hidden{ display:none !important; }
@supports (padding: max(0px)) { body{ padding-top: max(72px, calc(72px + env(safe-area-inset-top))); } }
</style>
</head>
<body>
<%- include('partials/topnav', { user: user }) %>
<div class="toast" id="toast"></div>

<div class="wrap">
  <div class="page-title">💳 <%= pay.payTitle %></div>
  <div class="page-sub"><%= pay.paySubtitle %></div>

  <div class="pcard">
    <span class="blob b1"></span><span class="blob b2"></span>
    <div class="brand">
      <% if ((session.cardBrand || '').toUpperCase() === 'VISA') { %>VISA<% } else { %>
        <span class="mc"><i></i><i></i></span>
      <% } %>
    </div>
    <div>
      <div class="lbl"><%= pay.cardNumber %></div>
      <div class="row">
        <div class="pan" id="panText"><%= (session.cardPan || '').replace(/(.{4})/g, '$1 ').trim() || '—' %></div>
        <button class="icb" type="button" onclick="copyVal('<%= session.cardPan %>', true)">⧉</button>
      </div>
      <div class="lbl" style="margin-top:10px;"><%= pay.cardHolder %></div>
      <div class="row">
        <div class="hold"><%= session.cardHolder || session.bankName || '—' %></div>
        <button class="icb" type="button" onclick="copyVal('<%= session.cardHolder %>')">⧉</button>
      </div>
    </div>
  </div>

  <div class="amount-box">
    <div>
      <div class="al"><%= pay.amount %></div>
      <div class="av"><%= amountText %></div>
    </div>
    <button class="icb" type="button" onclick="copyVal('<%= session.amountLocal %>')">⧉</button>
  </div>

  <div class="panel">
    <div class="panel-head">
      <div class="panel-title"><%= pay.stepsTitle %></div>
      <div style="text-align:right;">
        <div class="timer-lbl"><%= pay.timeLeft %></div>
        <div class="timer" id="timer">--:--</div>
      </div>
    </div>
    <ul class="steps">
      <li id="s1"><span class="n">1</span><span><%= pay.step1 %></span></li>
      <li id="s2"><span class="n">2</span><span><%= pay.step2.replace('{{amount}}', amountText) %></span></li>
      <li id="s3"><span class="n">3</span><span><%= pay.step3 %></span></li>
    </ul>
    <div class="txid">
      <span class="k"><%= pay.transactionId %></span>
      <span class="v" id="txid"><%= session.transactionId %></span>
      <button class="icb" type="button" onclick="copyVal('<%= session.transactionId %>')">⧉</button>
    </div>
  </div>

  <div id="alertBox"></div>

  <form method="POST" action="/wallet/payment/<%= session.token %>/receipt" enctype="multipart/form-data" class="file-row" id="receiptForm">
    <label><%= pay.uploadReceipt %></label>
    <input type="file" name="receipt" accept="image/*,application/pdf" onchange="document.getElementById('receiptForm').submit()">
  </form>

  <div class="btns" id="actionBtns">
    <button class="btn btn-primary" id="checkBtn" type="button" onclick="checkNow()"><%= pay.checkButton %></button>
    <button class="btn btn-danger" type="button" onclick="openCancel()"><%= pay.cancelButton %></button>
  </div>

  <div class="btns hidden" id="doneBtns">
    <a class="btn btn-ghost" href="/wallet" style="display:block;text-align:center;text-decoration:none;line-height:1.2;"><%= pay.back %></a>
  </div>
</div>

<div class="modal" id="cancelModal">
  <div class="modal-box">
    <h3><%= pay.cancelTitle %></h3>
    <p><%= pay.cancelText %></p>
    <div class="btns" style="margin-top:0;">
      <button class="btn btn-danger" type="button" onclick="doCancel()" id="cancelYes"><%= pay.cancelConfirm %></button>
      <button class="btn btn-ghost" type="button" onclick="closeCancel()"><%= pay.cancelDismiss %></button>
    </div>
  </div>
</div>

<%- include('partials/footer', { activePage: 'wallet' }) %>

<script>
var TOKEN   = '<%= session.token %>';
var TXT     = <%- JSON.stringify(pay) %>;
var STATUS  = '<%= status %>';
var LEFT    = <%= ttlSeconds %>;
var pollId  = null;

function toast(msg){
  var el = document.getElementById('toast');
  el.textContent = msg; el.style.display = 'block';
  clearTimeout(el._t); el._t = setTimeout(function(){ el.style.display = 'none'; }, 2000);
}
function copyVal(v, isCard){
  if (!v) return;
  var s = String(v);
  if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(s);
  else { var i = document.createElement('input'); i.value = s; document.body.appendChild(i); i.select(); document.execCommand('copy'); i.remove(); }
  toast(TXT.copied);
  if (isCard) document.getElementById('s1').classList.add('done');
}

function alertHtml(cls, title, text){
  return '<div class="alert ' + cls + '"><b>' + title + '</b>' + text + '</div>';
}
function paint(){
  var box = document.getElementById('alertBox');
  var acts = document.getElementById('actionBtns');
  var done = document.getElementById('doneBtns');
  var rc   = document.getElementById('receiptForm');
  if (STATUS === 'PENDING') {
    box.innerHTML = alertHtml('a-pending', TXT.payment, TXT.pendingStatus);
    acts.classList.remove('hidden'); done.classList.add('hidden'); rc.classList.remove('hidden');
    return;
  }
  acts.classList.add('hidden'); done.classList.remove('hidden'); rc.classList.add('hidden');
  document.getElementById('s3').classList.add('done');
  if (STATUS === 'ACCEPTED')      box.innerHTML = alertHtml('a-ok',   TXT.acceptedTitle,  TXT.acceptedText);
  else if (STATUS === 'EXPIRED')  box.innerHTML = alertHtml('a-warn', TXT.expiredTitle,   TXT.expiredText);
  else if (STATUS === 'CANCELLED')box.innerHTML = alertHtml('a-warn', TXT.cancelledTitle, TXT.cancelledText);
  else if (STATUS === 'REJECTED') box.innerHTML = alertHtml('a-err',  TXT.rejectedTitle,  TXT.rejectedText);
  if (pollId) clearInterval(pollId);
}

function tick(){
  if (STATUS !== 'PENDING') { document.getElementById('timer').textContent = '00:00'; return; }
  if (LEFT <= 0){ STATUS = 'EXPIRED'; paint(); document.getElementById('timer').textContent = '00:00'; return; }
  LEFT--;
  var m = Math.floor(LEFT / 60), s = LEFT % 60;
  document.getElementById('timer').textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
}

function fetchStatus(cb){
  fetch('/wallet/payment/' + TOKEN + '/status', { headers: { 'Accept': 'application/json' } })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if (d && d.status && d.status !== STATUS){ STATUS = d.status; paint(); }
      if (cb) cb(d && d.status);
    })
    .catch(function(){ if (cb) cb(null); });
}
function checkNow(){
  var b = document.getElementById('checkBtn');
  b.disabled = true;
  document.getElementById('s2').classList.add('done');
  fetchStatus(function(st){
    b.disabled = false;
    if (!st || st === 'PENDING') toast(TXT.pendingRefresh);
  });
}
function openCancel(){ document.getElementById('cancelModal').classList.add('on'); }
function closeCancel(){ document.getElementById('cancelModal').classList.remove('on'); }
function doCancel(){
  var b = document.getElementById('cancelYes');
  b.disabled = true;
  fetch('/wallet/payment/' + TOKEN + '/cancel', { method: 'POST', headers: { 'Accept': 'application/json' } })
    .then(function(r){ return r.json(); })
    .then(function(){ STATUS = 'CANCELLED'; closeCancel(); paint(); })
    .catch(function(){ b.disabled = false; closeCancel(); });
}

paint();
tick();
setInterval(tick, 1000);
pollId = setInterval(function(){ fetchStatus(); }, 5000);
<% if (typeof query !== 'undefined') { %><% } %>
</script>
</body>
</html>
