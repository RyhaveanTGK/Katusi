<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Qaliblər – One Loto</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{ box-sizing:border-box; margin:0; padding:0; }
::-webkit-scrollbar{ display:none; }
html,body{ overflow-x:hidden; }
:root{
  --bg-purple:#3d0d62;
  --primary-yellow:#f5c518;
  --secondary-purple:#5c2491;
}
body{
  background:var(--bg-purple); color:#fff;
  font-family:'Inter',sans-serif; min-height:100vh;
  padding-top:72px; padding-bottom:24px;
}
.wrap{ width:100%; max-width:414px; margin:0 auto; padding:14px 14px 24px; }
.page-title{ font-size:22px; font-weight:900; margin-bottom:4px; }
.page-sub{ font-size:12.5px; color:rgba(255,255,255,.55); margin-bottom:14px; line-height:1.5; }

/* ── Dövr paneli ── */
.cycle-box{
  background:linear-gradient(160deg, rgba(245,197,24,.16), rgba(92,36,145,.35));
  border:1px solid rgba(245,197,24,.32);
  border-radius:16px; padding:14px; margin-bottom:14px;
}
.cycle-top{ display:flex; align-items:center; justify-content:space-between; gap:10px; }
.cycle-lbl{ font-size:11px; font-weight:800; letter-spacing:1.2px; text-transform:uppercase; color:rgba(255,255,255,.6); }
.cycle-timer{ font-size:22px; font-weight:900; color:var(--primary-yellow); font-variant-numeric:tabular-nums; }
.cycle-prizes{ display:flex; gap:6px; margin-top:12px; }
.cp{ flex:1; background:rgba(0,0,0,.22); border-radius:11px; padding:8px 6px; text-align:center; }
.cp .r{ font-size:10.5px; font-weight:800; color:rgba(255,255,255,.6); }
.cp .v{ font-size:13px; font-weight:900; margin-top:3px; }
.cp.g1 .v{ color:#ffd700; } .cp.g2 .v{ color:#d8d8d8; } .cp.g3 .v{ color:#e2a06a; } .cp.g4 .v{ color:#9be6b4; }

/* ── Mənim yerim ── */
.me-box{
  display:flex; align-items:center; gap:12px;
  background:rgba(245,197,24,.12); border:1px solid rgba(245,197,24,.35);
  border-radius:14px; padding:12px 14px; margin-bottom:14px;
}
.me-rank{
  width:38px; height:38px; border-radius:12px; flex:0 0 38px;
  display:flex; align-items:center; justify-content:center;
  font-size:14px; font-weight:900; color:#3d2200;
  background:linear-gradient(135deg,#ffd700,#f0a800);
}
.me-info{ flex:1; min-width:0; }
.me-t{ font-size:13.5px; font-weight:800; }
.me-s{ font-size:11.5px; color:rgba(255,255,255,.6); margin-top:2px; }
.me-p{ font-size:14px; font-weight:900; color:var(--primary-yellow); text-align:right; flex-shrink:0; }

.tab-row{ display:flex; border-radius:12px; overflow:hidden; border:1px solid rgba(255,255,255,.15); margin-bottom:14px; }
.tab-btn{
  flex:1; padding:11px 6px; font-size:12.5px; font-weight:700; border:none; cursor:pointer;
  background:rgba(255,255,255,.07); color:rgba(255,255,255,.7); transition:background .2s,color .2s;
  font-family:'Inter',sans-serif;
}
.tab-btn.active{ background:var(--secondary-purple); color:#fff; }

.rank-row{
  display:flex; align-items:center; gap:11px;
  padding:11px 13px; background:rgba(255,255,255,.05);
  border-radius:12px; margin-bottom:7px; border:1px solid rgba(255,255,255,.08);
}
.rank-row.mine{ border-color:rgba(245,197,24,.55); background:rgba(245,197,24,.1); }
.rank-medal{
  width:32px; height:32px; border-radius:50%; flex:0 0 32px;
  display:flex; align-items:center; justify-content:center;
  font-weight:800; font-size:13.5px; color:#3d2200;
  border:2px solid rgba(255,255,255,.5);
}
.rank-1{ background:linear-gradient(135deg,#ffd700,#f0a800); }
.rank-2{ background:linear-gradient(135deg,#c0c0c0,#a0a0a0); }
.rank-3{ background:linear-gradient(135deg,#cd7f32,#a0522d); }
.rank-other{ background:rgba(255,255,255,.14); color:#fff; border-color:rgba(255,255,255,.28); font-size:12.5px; }
.rank-info{ flex:1; min-width:0; }
.rank-name{ font-size:14.5px; font-weight:800; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.rank-stats{ font-size:11.5px; color:rgba(255,255,255,.5); margin-top:2px; display:flex; align-items:center; gap:5px; }
.rank-right{ flex-shrink:0; text-align:right; }
.rank-stars{ font-size:14.5px; font-weight:900; color:#fff; white-space:nowrap; }
.rank-prize{ font-size:11.5px; font-weight:800; color:var(--primary-yellow); margin-top:2px; white-space:nowrap; }

.recent-item{
  display:flex; align-items:center; gap:10px;
  padding:11px 13px; background:rgba(255,255,255,.05);
  border-radius:12px; margin-bottom:7px; border:1px solid rgba(255,255,255,.08);
}
.ri-icon{ font-size:22px; flex-shrink:0; }
.ri-info{ flex:1; min-width:0; }
.ri-name{ font-size:14px; font-weight:800; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.ri-room{ font-size:11.5px; color:rgba(255,255,255,.5); }
.ri-prize{ font-size:14.5px; font-weight:900; color:#1cb85d; flex-shrink:0; }
.ri-date{ font-size:10.5px; color:rgba(255,255,255,.4); margin-top:2px; }

.empty-state{ text-align:center; padding:38px 20px; color:rgba(255,255,255,.4); }
.empty-state .icon{ font-size:44px; margin-bottom:10px; }
.note{ font-size:11px; line-height:1.6; color:rgba(255,255,255,.42); margin-top:14px; text-align:center; }

@media (max-width:370px){
  .rank-row{ padding:10px 11px; gap:9px; }
  .rank-medal{ width:29px; height:29px; flex:0 0 29px; font-size:12px; }
  .rank-name{ font-size:13.5px; }
  .rank-stars{ font-size:13.5px; }
  .cycle-timer{ font-size:19px; }
  .cp .v{ font-size:11.5px; }
}
@supports (padding: max(0px)) {
  body{ padding-top: max(72px, calc(72px + env(safe-area-inset-top))); }
}
</style>
</head>
<body>
<%- include('partials/topnav', { user: user }) %>

<%
function fmtStars(n){
  n = Number(n || 0);
  if (n >= 1000000) return (n / 1000000).toFixed(n % 1000000 === 0 ? 0 : 1) + 'M';
  if (n >= 1000) return (n / 1000).toFixed(n % 1000 === 0 ? 0 : 1) + 'K';
  return String(n);
}
%>

<div class="wrap">
  <div class="page-title">⭐ Qaliblər</div>
  <div class="page-sub">
    Liderboard ən çox ulduz yığan oyunçulara görədir — bütün otaqlarda
    biletin qiymətinə görə ulduz qazanırsınız.
  </div>

  <div class="cycle-box">
    <div class="cycle-top">
      <div>
        <div class="cycle-lbl">Uduşlara qalan vaxt</div>
        <div class="cycle-timer" id="cycleTimer" data-left="<%= secondsLeft %>">--:--:--</div>
      </div>
      <div style="font-size:34px;line-height:1;">⭐</div>
    </div>
    <div class="cycle-prizes">
      <div class="cp g1"><div class="r">1-ci</div><div class="v"><%= fmtStars(prizes.first) %></div></div>
      <div class="cp g2"><div class="r">2-ci</div><div class="v"><%= fmtStars(prizes.second) %></div></div>
      <div class="cp g3"><div class="r">3-cü</div><div class="v"><%= fmtStars(prizes.third) %></div></div>
      <div class="cp g4"><div class="r">4–<%= prizes.size %></div><div class="v"><%= fmtStars(prizes.rest) %></div></div>
    </div>
  </div>

  <div class="me-box">
    <div class="me-rank"><%= me.rank ? '#' + me.rank : '—' %></div>
    <div class="me-info">
      <div class="me-t"><%= user.username %></div>
      <div class="me-s">
        Bu dövrdə <%= me.periodStars.toLocaleString('az-AZ') %> ulduz
        <% if (!me.rank) { %> • siyahıya düşmək üçün oyna<% } %>
      </div>
    </div>
    <div class="me-p"><%= me.prize > 0 ? '+' + fmtStars(me.prize) + ' ⭐' : '—' %></div>
  </div>

  <div class="tab-row">
    <button class="tab-btn active" onclick="showTab('top')">Ulduz liderboardu</button>
    <button class="tab-btn" onclick="showTab('recent')">Son qaliblər</button>
  </div>

  <div id="tab-top">
    <% if (!leaders.length) { %>
      <div class="empty-state"><div class="icon">⭐</div><div>Bu dövrdə hələ ulduz yığan yoxdur</div></div>
    <% } %>
    <% leaders.forEach(function(r){ %>
      <div class="rank-row <%= (!r.isBot && String(r.id) === String(user._id)) ? 'mine' : '' %>">
        <div class="rank-medal <%= r.rank === 1 ? 'rank-1' : r.rank === 2 ? 'rank-2' : r.rank === 3 ? 'rank-3' : 'rank-other' %>"><%= r.rank %></div>
        <div class="rank-info">
          <div class="rank-name"><%= r.name %></div>
          <div class="rank-stats"><%= r.gamesPlayed %> bilet • ümumi <%= fmtStars(r.stars) %> ⭐</div>
        </div>
        <div class="rank-right">
          <div class="rank-stars"><%= r.periodStars.toLocaleString('az-AZ') %> ⭐</div>
          <div class="rank-prize">uduş +<%= fmtStars(r.prize) %></div>
        </div>
      </div>
    <% }); %>
    <div class="note">
      Hər 24 saatdan bir uduşlar avtomatik balansa köçürülür və sayğaclar sıfırlanır.
      <% if (lastCycle) { %>
        <br>Son ödəniş: <%= new Date(lastCycle.paidAt).toLocaleString('az-AZ', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) %>
        · <%= fmtStars(lastCycle.totalPaid) %> ⭐
      <% } %>
    </div>
  </div>

  <div id="tab-recent" style="display:none;">
    <% if (!recentGames.length) { %>
      <div class="empty-state"><div class="icon">🎯</div><div>Hələ heç bir oyun bitməyib</div></div>
    <% } %>
    <% recentGames.forEach(function(g){ %>
      <div class="recent-item">
        <div class="ri-icon">🎊</div>
        <div class="ri-info">
          <div class="ri-name"><%= g.userId ? g.userId.username : 'İstifadəçi' %></div>
          <div class="ri-room"><%= g.roomId ? g.roomId.name : 'Otaq' %></div>
          <div class="ri-date"><%= new Date(g.playedAt).toLocaleString('az-AZ', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) %></div>
        </div>
        <div class="ri-prize">+<%= g.prize.toFixed(2) %> ₼</div>
      </div>
    <% }); %>
  </div>
</div>

<%- include('partials/footer', { activePage: 'winners' }) %>

<script>
function showTab(tab){
  document.getElementById('tab-top').style.display    = tab==='top'    ? 'block':'none';
  document.getElementById('tab-recent').style.display = tab==='recent' ? 'block':'none';
  document.querySelectorAll('.tab-btn').forEach(function(b,i){
    b.classList.toggle('active', (tab==='top' && i===0) || (tab==='recent' && i===1));
  });
}
(function(){
  var el = document.getElementById('cycleTimer');
  var left = parseInt(el.dataset.left || '0', 10);
  function two(n){ return (n<10?'0':'') + n; }
  function paint(){
    if (left <= 0){ el.textContent = 'Uduşlar paylanır…'; return; }
    var h = Math.floor(left/3600), m = Math.floor((left%3600)/60), s = left%60;
    el.textContent = two(h)+':'+two(m)+':'+two(s);
    left -= 1;
    setTimeout(paint, 1000);
  }
  paint();
})();
</script>
</body>
</html>
