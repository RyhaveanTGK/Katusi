      <a href="/winners">Qaliblər</a>
      <a href="/profile/referral">Dəvət</a>
    </div>
    <div class="footer-col">
      <h4>Bizimlə əlaqə</h4>
      <a href="mailto:support@birloto.com">support@birloto.com</a>
