<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<style>
.quick-nav-wrapper{position:fixed;left:0;right:0;bottom:0;z-index:1000;background:rgba(20,5,35,.92);backdrop-filter:blur(10px);border-top:1px solid rgba(255,255,255,.1);box-shadow:0 -4px 18px rgba(0,0,0,.35);}
.quick-nav{display:flex;align-items:center;justify-content:space-around;max-width:430px;margin:0 auto;padding:8px 6px calc(8px + env(safe-area-inset-bottom));}
.qnav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;text-decoration:none;font-size:10px;font-weight:800;letter-spacing:.2px;color:rgba(255,255,255,.55);transition:color .18s,transform .12s;padding:2px 0;}
.qnav-item .material-symbols-outlined{font-size:23px;line-height:1;}
.qnav-item:active{transform:scale(.92);}.qnav-item.active{color:#f5c518;}
.qnav-item.active .material-symbols-outlined{filter:drop-shadow(0 2px 6px rgba(245,197,24,.45));}
.footer-bar{background:rgba(20,5,35,.7);border-top:1px solid rgba(255,255,255,.1);padding:16px 16px 92px;}
.footer-inner{max-width:430px;margin:0 auto;display:flex;justify-content:space-between;gap:16px;}
.footer-col h4{font-size:12px;font-weight:700;color:#fff;margin-bottom:6px;}
.footer-col a{display:block;font-size:11px;color:rgba(255,255,255,.6);text-decoration:none;margin-bottom:3px;line-height:1.4;}
.social-row{display:flex;gap:10px;margin-top:6px;}.social-icon{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;}
.soc-tg{background:#0088cc;}.soc-ig{background:linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);}.soc-wa{background:#25d366;}
.footer-copy{text-align:center;font-size:10px;color:rgba(255,255,255,.4);padding:8px 0 4px;max-width:430px;margin:0 auto;}.age18{width:22px;height:22px;border-radius:50%;border:2px solid rgba(255,255,255,.4);font-size:8px;font-weight:700;color:rgba(255,255,255,.5);display:inline-flex;align-items:center;justify-content:center;margin-right:4px;vertical-align:middle;}
body{padding-bottom:82px;}
</style>
