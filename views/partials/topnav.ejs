<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<style>
.topnav{
  font-family:'Rubik','Segoe UI',Tahoma,Arial,sans-serif;
  position:fixed;top:0;left:0;right:0;z-index:900;
  background: linear-gradient(180deg, rgba(30,8,55,.96) 0%, rgba(15,3,28,.98) 100%);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(245,197,24,.18);
  box-shadow: 0 6px 22px -6px rgba(0,0,0,.55);
  padding-top: env(safe-area-inset-top);
}
.header-inner{
  max-width: 430px; margin: 0 auto;
  display:flex; align-items:center; justify-content:space-between;
  padding: 10px 14px 10px;
}
.site-logo{
  display:flex; align-items:center; gap:8px; text-decoration:none;
  font-weight:900; font-size:20px; letter-spacing:.3px; line-height:1;
  user-select:none;
}
.site-logo .lg-one{ color:#f5c518; text-shadow:0 2px 6px rgba(245,197,24,.35), 0 1px 2px rgba(0,0,0,.5); }
.site-logo .lg-loto{ color:#fff; text-shadow:0 1px 2px rgba(0,0,0,.45); }
.site-logo .lg-chip{
  width:22px; height:22px; border-radius:50%;
  background: radial-gradient(circle at 35% 30%, #ffe27a 0%, #f5c518 45%, #b78d00 100%);
  border:2px dashed rgba(255,255,255,.85);
  box-shadow: 0 2px 6px rgba(0,0,0,.45), inset 0 0 0 2px rgba(0,0,0,.15);
}
.balance-box{
  display:flex;align-items:center;gap:8px;
  background: linear-gradient(180deg, rgba(92,36,145,.55), rgba(60,20,110,.55));
  border: 1px solid rgba(245,197,24,.35);
  padding: 7px 14px; border-radius: 16px;
  text-decoration:none;
  box-shadow: 0 4px 12px -4px rgba(0,0,0,.45);
}
.balance-box .b-label{ font-size:12px; color:rgba(255,255,255,.75); font-weight:600; }
.balance-box .b-value{ font-size:16px; font-weight:900; color:#f5c518; display:flex; align-items:center; gap:4px; transition: color .25s ease, transform .25s ease; }
.balance-box.bal-up .b-value{ color:#4ce07a; transform: scale(1.12); }
.balance-box.bal-down .b-value{ color:#ff7a7a; transform: scale(.94); }
.balance-box{ position:relative; }
.bal-float{
  position:absolute; right:12px; top:50%; transform:translateY(-50%);
  font-size:13px; font-weight:900; pointer-events:none; opacity:0;
  text-shadow:0 2px 6px rgba(0,0,0,.6); white-space:nowrap;
}
.bal-float.up{ color:#4ce07a; animation: bal-fly-up 1.15s ease forwards; }
.bal-float.down{ color:#ff7a7a; animation: bal-fly-down 1.15s ease forwards; }
@keyframes bal-fly-up{
  0%{ opacity:0; transform:translateY(-10%) scale(.8); }
  25%{ opacity:1; transform:translateY(-90%) scale(1.05); }
  100%{ opacity:0; transform:translateY(-190%) scale(1); }
}
@keyframes bal-fly-down{
  0%{ opacity:0; transform:translateY(-90%) scale(.8); }
  25%{ opacity:1; transform:translateY(-10%) scale(1.05); }
  100%{ opacity:0; transform:translateY(70%) scale(1); }
}
.coin-icon{ font-size:16px; color:#f5c518; line-height:1; }
img.emoji{ height:1em; width:1em; margin:0 .05em 0 .1em; vertical-align:-0.12em; display:inline-block; }
@media (max-width: 360px){
  .header-inner { padding: 8px 10px; }
  .site-logo { font-size: 18px; }
  .balance-box { padding: 6px 10px; }
  .balance-box .b-value { font-size: 14px; }
}
</style>

<div class="topnav">
  <div class="header-inner">
    <a class="site-logo" href="/" aria-label="One Loto">
      <span class="lg-chip" aria-hidden="true"></span>
      <span class="lg-one">One</span><span class="lg-loto">Loto</span>
    </a>
    <a class="balance-box" id="balanceBox" href="/wallet" data-balance="<%= user ? Number(user.balance || 0).toFixed(2) : '0.00' %>">
      <span class="b-label">Balans:</span>
      <span class="b-value">
        <span id="balanceValue"><%= user ? Number(user.balance || 0).toFixed(2) : '0.00' %></span>
        <span class="coin-icon">₼</span>
      </span>
    </a>
  </div>
</div>

<script>
/* ── Balans animasiyası: pul əlavə olunduqda / çıxdıqda hərəkətli sayğac ── */
(function(){
  var box = document.getElementById('balanceBox');
  var el  = document.getElementById('balanceValue');
  if (!box || !el) return;

  var current = parseFloat(box.dataset.balance || '0') || 0;
  var raf = null;

  function paint(v){ el.textContent = (Math.round(v * 100) / 100).toFixed(2); }

  function floatLabel(delta){
    var f = document.createElement('span');
    f.className = 'bal-float ' + (delta > 0 ? 'up' : 'down');
    f.textContent = (delta > 0 ? '+' : '−') + Math.abs(delta).toFixed(2) + ' ₼';
    box.appendChild(f);
    setTimeout(function(){ if (f.parentNode) f.parentNode.removeChild(f); }, 1300);
  }

  window.animateBalance = function(target, opts){
    target = Number(target);
    if (!isFinite(target)) return;
    var from = current;
    var delta = Number((target - from).toFixed(2));
    current = target;
    box.dataset.balance = target.toFixed(2);
    try { localStorage.setItem('ol_balance', target.toFixed(2)); } catch(e){}
    if (Math.abs(delta) < 0.005) { paint(target); return; }

    box.classList.remove('bal-up','bal-down');
    void box.offsetWidth;
    box.classList.add(delta > 0 ? 'bal-up' : 'bal-down');
    if (!opts || opts.label !== false) floatLabel(delta);

    var start = performance.now(), dur = 900;
    if (raf) cancelAnimationFrame(raf);
    (function step(now){
      var t = Math.min(1, (now - start) / dur);
      var e = 1 - Math.pow(1 - t, 3);
      paint(from + delta * e);
      if (t < 1) raf = requestAnimationFrame(step);
      else { paint(target); setTimeout(function(){ box.classList.remove('bal-up','bal-down'); }, 250); }
    })(start);
  };

  window.getBalance = function(){ return current; };

  // Səhifə keçidlərində (bilet alışı, uduş) fərqi animasiya ilə göstər
  try {
    var prev = parseFloat(localStorage.getItem('ol_balance'));
    if (isFinite(prev) && Math.abs(prev - current) >= 0.005) {
      var real = current;
      current = prev;
      paint(prev);
      setTimeout(function(){ window.animateBalance(real); }, 260);
    } else {
      localStorage.setItem('ol_balance', current.toFixed(2));
    }
  } catch(e){}
})();
</script>

<script src="https://cdn.jsdelivr.net/npm/@twemoji/api@latest/dist/twemoji.min.js" crossorigin="anonymous"></script>
<script>
(function(){
  function run(){
    if (window.twemoji && document.body){
      twemoji.parse(document.body, { folder:'svg', ext:'.svg',
        base:'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/' });
    }
  }
  if (document.readyState !== 'loading') run();
  else document.addEventListener('DOMContentLoaded', run);
  var mo = new MutationObserver(function(m){ for (var i=0;i<m.length;i++){ if(m[i].addedNodes && m[i].addedNodes.length){ run(); break; } } });
  document.addEventListener('DOMContentLoaded', function(){ mo.observe(document.body, {childList:true, subtree:true}); });
})();
</script>

<!-- Global kopyalama qadağası: yalnız login/şifrə/bonus code sahələrində icazə verilir -->
<style>
  body, body * { -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none; user-select: none; -webkit-touch-callout: none; }
  input, textarea, [contenteditable="true"] { -webkit-user-select: text !important; -moz-user-select: text !important; -ms-user-select: text !important; user-select: text !important; -webkit-touch-callout: default !important; }
</style>
<script>
(function(){
  function isAllowedField(el){
    if (!el) return false;
    var tag = (el.tagName || '').toUpperCase();
    if (tag !== 'INPUT' && tag !== 'TEXTAREA') return false;
    var type = (el.type || '').toLowerCase();
    var name = ((el.name || '') + ' ' + (el.id || '') + ' ' + (el.className || '') + ' ' + (el.getAttribute('autocomplete') || '')).toLowerCase();
    // Login / şifrə / parol dəyişmə / bonus kodu üçün icazə
    if (type === 'password') return true;
    if (/user|login|email|phone|nomre|bonus|promo|code|kod|current-password|new-password|old-password|pass|parol|sifre|şifr/.test(name)) return true;
    // parol dəyişmə səhifəsindəki bütün text sahələrinə icazə
    if (/changepass|change-password|parol-deyis|password/.test((location.pathname || '').toLowerCase())) return true;
    return false;
  }
  function block(e){
    var t = e.target;
    if (isAllowedField(t)) return; // icazəli sahə
    if (t && t.closest && t.closest('input, textarea')) {
      if (isAllowedField(t.closest('input, textarea'))) return;
    }
    e.preventDefault();
    e.stopPropagation();
    return false;
  }
  ['copy','cut','contextmenu','dragstart','selectstart'].forEach(function(ev){
    document.addEventListener(ev, block, true);
  });
  // Klaviatura qısayolları (Ctrl/Cmd + C / X / A / S / P / U)
  document.addEventListener('keydown', function(e){
    var t = e.target;
    if (isAllowedField(t)) return;
    var mod = e.ctrlKey || e.metaKey;
    if (!mod) return;
    var k = (e.key || '').toLowerCase();
    if (['c','x','a','s','p','u'].indexOf(k) !== -1){
      e.preventDefault(); e.stopPropagation(); return false;
    }
  }, true);
})();
</script>
