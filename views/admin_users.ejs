<!DOCTYPE html>
<html lang="az"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>One Loto – İstifadəçilər</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:'Inter',Arial,sans-serif}
body{background:#0d0620;color:#fff;padding:16px 12px 100px}
.hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.logo{color:#f5c518;font-weight:900;font-size:20px}
.nav{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
.nav a{padding:8px 12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:10px;color:#fff;text-decoration:none;font-size:13px;font-weight:600}
.nav a.on{background:#f5c518;color:#3d2200;border-color:#f5c518}
.search{width:100%;padding:11px 14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);border-radius:10px;color:#fff;font-size:14px;margin-bottom:14px}
.card{background:linear-gradient(160deg,rgba(255,255,255,.05),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:14px;margin-bottom:10px}
.u-hd{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap}
.u-nm{font-weight:800;font-size:15px}
.u-em{font-size:12px;color:rgba(255,255,255,.5)}
.u-bl{background:#e8001a;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:800}
.u-bal{color:#f5c518;font-weight:900;font-size:16px}
.row{display:flex;gap:8px;font-size:12px;color:rgba(255,255,255,.7);margin-top:8px;flex-wrap:wrap}
.row b{color:#fff}
form.inline{display:flex;gap:6px;margin-top:10px;flex-wrap:wrap}
form.inline input[type=number]{width:100px;padding:8px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);border-radius:8px;color:#fff;font-size:13px}
form.inline input[type=text]{flex:1;min-width:120px;padding:8px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);border-radius:8px;color:#fff;font-size:13px}
form.inline button{padding:8px 12px;border:none;border-radius:8px;font-weight:800;font-size:12px;cursor:pointer}
.b-add{background:#22c55e;color:#0d1a08}
.b-blk{background:#f97316;color:#2a1204}
.b-unb{background:#3b82f6;color:#08132a}
</style></head><body>
<div class="hdr"><div class="logo">One Loto · Admin</div><a href="/logout" style="color:#f5c518;font-size:12px;text-decoration:none">Çıxış</a></div>
<div class="nav">
  <a href="/admin/users" class="on">İstifadəçilər</a>
  <a href="/admin/transactions">Əməliyyatlar</a>
  <a href="/admin/rooms">Otaqlar</a>
  <a href="/admin/live-games">Canlı oyunlar</a>
  <a href="/admin/bonus">Bonus kodları</a>
</div>
<form method="GET"><input class="search" type="text" name="q" value="<%= q %>" placeholder="Ad, e-poçt və ya telefon axtar..."></form>

<% users.forEach(function(u){ 
   var dep = depMap[String(u._id)]; var wd = wdMap[String(u._id)]; %>
<div class="card">
  <div class="u-hd">
    <div>
      <div class="u-nm"><%= u.username %> <% if(u.isBlocked){ %><span class="u-bl">BLOKLU</span><% } %></div>
      <div class="u-em"><%= u.email %> · <%= u.phone||'—' %></div>
    </div>
    <div class="u-bal"><%= (u.balance||0).toFixed(2) %> AZN</div>
  </div>
  <div class="row">
    <span>Son depozit: <b><%= dep? dep.amount.toFixed(2)+' AZN · '+new Date(dep.at).toLocaleDateString('az-AZ') : '—' %></b></span>
    <span>Son çıxarış: <b><%= wd? wd.amount.toFixed(2)+' AZN · '+new Date(wd.at).toLocaleDateString('az-AZ') : '—' %></b></span>
  </div>
  <form class="inline" method="POST" action="/admin/users/<%= u._id %>/balance">
    <input type="number" step="0.01" name="delta" placeholder="+/- AZN" required>
    <input type="text" name="note" placeholder="Qeyd (opsional)">
    <button class="b-add" type="submit">Balans dəyiş</button>
  </form>
  <form class="inline" method="POST" action="/admin/users/<%= u._id %>/toggle-block">
    <% if(!u.isBlocked){ %>
      <input type="text" name="reason" placeholder="Səbəb">
      <button class="b-blk" type="submit">Blokla</button>
    <% } else { %>
      <button class="b-unb" type="submit">Bloku aç</button>
    <% } %>
  </form>
</div>
<% }); %>
<% if(!users.length){ %><p style="text-align:center;color:rgba(255,255,255,.5);margin-top:30px">İstifadəçi tapılmadı</p><% } %>
</body></html>
