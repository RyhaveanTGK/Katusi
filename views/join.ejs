<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Otaq – One Loto</title>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/loto.css">
</head>
<body>

<%- include('partials/topnav', { user: user }) %>

<div class="gamebar">
  <div class="statbar">
    <div class="stat-pill">
      <div class="bet"><%= Number(room.entryFee || 0).toFixed(2) %><span class="mult"><%= room.prizeMultiplier || 'x2' %></span></div>
      <div class="item"><span class="material-symbols-outlined">person</span><span id="playerCount"><%= room.players.length %></span></div>
      <div class="sep"></div>
      <div class="item"><span class="material-symbols-outlined">emoji_events</span><span id="roomPrize"><%= Number(ticketPrize || 0).toFixed(2) %> ₼</span></div>
    </div>
    <button class="icon-btn" id="soundBtn" type="button" aria-label="Səs"><span class="material-symbols-outlined" id="soundIcon">volume_up</span></button>
  </div>
</div>

<div class="wrap">
  <% if (typeof error !== 'undefined' && error) { %><div class="error-msg"><%= error %></div><% } %>
  <div id="ticketList"></div>
  <div class="hint">Bilet rəqəmlərini <b>yenilə</b> və ya <b>dəyiş</b> ilə seçin, artıq bileti <b>sil</b>. Maksimum <%= maxTickets %> bilet.</div>
</div>

<form method="POST" action="/join/<%= room._id %>" id="buyForm">
  <input type="hidden" name="tickets" id="ticketsField">
  <input type="hidden" name="quantity" id="quantityField" value="1">
  <div class="buybar">
    <div class="buybar-inner">
      <button class="buy-btn" type="submit" id="buyBtn">
        <div class="buy-main">BİLET AL <span id="buyTotal"><%= Number(room.entryFee || 0).toFixed(2) %></span> ₼</div>
        <div class="buy-sub">Qazan ⭐ <%= room.starPrize || 0 %></div>
      </button>
      <div class="qty">
        <button class="qty-btn minus" type="button" id="minusBtn" aria-label="Azalt">−</button>
        <div class="qty-box">
          <div class="qty-label">Biletlər</div>
          <div class="qty-val" id="qtyVal">1</div>
        </div>
        <button class="qty-btn plus" type="button" id="plusBtn" aria-label="Artır">+</button>
      </div>
    </div>
  </div>
</form>

<div class="toast" id="toast"></div>

<script src="/assets/js/loto-sound.js"></script>
<script>
var MAX_TICKETS = <%= maxTickets %>;
var ENTRY_FEE   = <%= Number(room.entryFee || 0) %>;
var POOL        = <%- JSON.stringify(previewCards) %>;
var tickets     = [POOL[0]];
var MY_NAME     = <%- JSON.stringify(user.username) %>;
var lastStake   = null;

function renderPlayers(){ /* onlayn oyunçular siyahısı silindi */ }

function toast(msg){
  var el = document.getElementById('toast');
  el.textContent = msg; el.classList.add('show');
  clearTimeout(window.__t); window.__t = setTimeout(function(){ el.classList.remove('show'); }, 2000);
}

/* ── random bilet generatoru (klient tərəfi önizləmə) ── */
function genCard(){
  var cols=[[1,9],[10,19],[20,29],[30,39],[40,49],[50,59],[60,69],[70,79],[80,100]];
  var card=[[],[],[]], used=[];
  for(var i=0;i<9;i++) used.push({});
  for(var r=0;r<3;r++){
    card[r]=new Array(9).fill(0);
    var chosen=[];
    while(chosen.length<5){ var c=Math.floor(Math.random()*9); if(chosen.indexOf(c)<0) chosen.push(c); }
    chosen.sort(function(a,b){return a-b;});
    chosen.forEach(function(c){
      var min=cols[c][0], max=cols[c][1], v;
      do { v=Math.floor(Math.random()*(max-min+1))+min; } while(used[c][v]);
      used[c][v]=true; card[r][c]=v;
    });
  }
  return card;
}

function ticketNode(numbers, index){
  var box = document.createElement('div');
  box.className = 'ticket';
  var tools = document.createElement('div');
  tools.className = 'ticket-tools';
  tools.innerHTML =
    '<button class="tool" data-act="refresh" type="button"><span class="material-symbols-outlined">refresh</span><span class="tool-label">yenilə</span></button>' +
    '<button class="tool" data-act="delete" type="button"><span class="material-symbols-outlined">delete</span><span class="tool-label">sil</span></button>' +
    '<button class="tool" data-act="change" type="button"><span class="material-symbols-outlined">edit</span><span class="tool-label">dəyiş</span></button>' +
    '<span class="ticket-no">#' + (index + 1) + '</span>';
  box.appendChild(tools);

  var grid = document.createElement('div');
  grid.className = 'grid';
  numbers.forEach(function(row){
    row.forEach(function(n){
      var cell = document.createElement('div');
      cell.className = 'cell' + (n ? '' : ' empty');
      cell.textContent = n || '';
      grid.appendChild(cell);
    });
  });
  box.appendChild(grid);

  tools.addEventListener('click', function(e){
    var btn = e.target.closest('.tool');
    if (!btn) return;
    var act = btn.dataset.act;
    if (act === 'delete') {
      if (tickets.length === 1) return toast('Ən azı 1 bilet olmalıdır');
      tickets.splice(index, 1);
      LotoSound.place();
      render();
      return toast('Bilet silindi');
    }
    tickets[index] = genCard();
    LotoSound.place();
    render();
    toast(act === 'refresh' ? 'Bilet yeniləndi' : 'Bilet dəyişdirildi');
  });

  return box;
}

function render(){
  var list = document.getElementById('ticketList');
  list.innerHTML = '';
  tickets.forEach(function(t, i){ list.appendChild(ticketNode(t, i)); });
  document.getElementById('qtyVal').textContent = tickets.length;
  document.getElementById('buyTotal').textContent = (ENTRY_FEE * tickets.length).toFixed(2);
  document.getElementById('minusBtn').disabled = tickets.length <= 1;
  document.getElementById('plusBtn').disabled  = tickets.length >= MAX_TICKETS;
  document.getElementById('quantityField').value = tickets.length;
  document.getElementById('ticketsField').value = JSON.stringify(tickets);
}

document.getElementById('plusBtn').addEventListener('click', function(){
  if (tickets.length >= MAX_TICKETS) return toast('Maksimum ' + MAX_TICKETS + ' bilet');
  tickets.push(POOL[tickets.length] || genCard());
  LotoSound.place();
  render();
});
document.getElementById('minusBtn').addEventListener('click', function(){
  if (tickets.length <= 1) return toast('Ən azı 1 bilet olmalıdır');
  tickets.pop();
  LotoSound.place();
  render();
});
document.getElementById('buyForm').addEventListener('submit', function(){
  document.getElementById('buyBtn').disabled = true;
  document.getElementById('ticketsField').value = JSON.stringify(tickets);
});

/* ── səs aç/bağla ── */
(function(){
  var btn = document.getElementById('soundBtn');
  var icon = document.getElementById('soundIcon');
  function paint(){ icon.textContent = LotoSound.isOn() ? 'volume_up' : 'volume_off'; }
  paint();
  btn.addEventListener('click', function(){ LotoSound.toggle(); paint(); });
})();

/* ── canlı otaq statistikası ── */
function poll(){
  fetch('/api/room/<%= room._id %>').then(function(r){ return r.json(); }).then(function(d){
    if (!d || d.error) return;
    document.getElementById('playerCount').textContent = d.player_count;
    document.getElementById('roomPrize').textContent = Number(d.ticket_prize || 0).toFixed(2) + ' ₼';
    renderPlayers(d);
    if (typeof d.balance === 'number' && window.animateBalance && Math.abs(window.getBalance() - d.balance) >= 0.005) {
      window.animateBalance(d.balance);
    }
  }).catch(function(){});
}
render();
poll();
setInterval(poll, 2500);
</script>
</body>
</html>
