<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title><%= t('join.title') %> – One Loto</title>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:#160a26;color:#fff;font-family:'Rubik',sans-serif;padding:78px 0 96px}
.wrap{max-width:520px;margin:0 auto;padding:0 14px}
.room-head{background:linear-gradient(180deg,#3a0f60,#26093f);border:1px solid rgba(245,197,24,.25);border-radius:20px;padding:14px 16px;margin-bottom:14px;box-shadow:0 18px 34px -20px rgba(0,0,0,.8)}
.rh-top{display:flex;align-items:center;justify-content:space-between;gap:10px}
.rh-name{font-size:16px;font-weight:900}
.rh-state{font-size:11.5px;font-weight:800;padding:5px 10px;border-radius:99px;background:rgba(31,155,59,.18);color:#5fd07a;display:flex;align-items:center;gap:5px}
.rh-state.starting{background:rgba(229,57,53,.16);color:#ff8a80}
.rh-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.rh-cell{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.10);border-radius:14px;padding:9px 10px;text-align:center}
.rh-lbl{font-size:10.5px;font-weight:700;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:.4px}
.rh-val{font-size:15px;font-weight:900;color:#f5c518;margin-top:3px}
.error-msg{background:rgba(232,0,26,.15);border:1px solid rgba(232,0,26,.3);border-radius:12px;padding:10px 14px;font-size:13px;color:#ff8080;margin-bottom:12px;text-align:center;font-weight:700}
.sec-title{font-size:12.5px;font-weight:800;color:rgba(255,255,255,.6);text-transform:uppercase;letter-spacing:.6px;margin:0 2px 8px}
.qty{display:flex;gap:8px;margin-bottom:14px}
.qty button{flex:1;padding:12px 0;border-radius:14px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.05);color:#fff;font-family:inherit;font-size:15px;font-weight:900;cursor:pointer;transition:.15s}
.qty button.on{background:linear-gradient(180deg,#ffd060,#f59200);color:#3a1c00;border-color:transparent;box-shadow:0 8px 18px -8px rgba(245,162,35,.8)}
.ticket{background:linear-gradient(180deg,#ffffff,#f1e7ff);border-radius:16px;padding:10px;margin-bottom:10px;box-shadow:0 12px 24px -16px rgba(0,0,0,.9)}
.t-head{display:flex;align-items:center;justify-content:space-between;margin:0 4px 8px}
.t-name{font-size:12px;font-weight:900;color:#4a1178}
.t-price{font-size:12px;font-weight:900;color:#8a2be2}
.grid9{display:grid;grid-template-columns:repeat(9,1fr);gap:4px}
.cell{aspect-ratio:1/1;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:900;color:#2b1044;background:#ffe9a8}
.cell.empty{background:rgba(74,17,120,.07)}
.total-bar{position:fixed;left:0;right:0;bottom:0;z-index:60;background:linear-gradient(180deg,rgba(22,10,38,.6),#160a26 40%);padding:12px 14px calc(14px + env(safe-area-inset-bottom))}
.total-inner{max-width:520px;margin:0 auto;display:flex;align-items:center;gap:10px}
.total-sum{flex:1}
.ts-l{font-size:11px;font-weight:700;color:rgba(255,255,255,.55)}
.ts-v{font-size:19px;font-weight:900;color:#f5c518}
.btn-buy{border:none;cursor:pointer;padding:15px 22px;border-radius:16px;font-family:inherit;font-size:16px;font-weight:900;color:#3a1c00;background:linear-gradient(180deg,#ffd060,#f59200);box-shadow:0 10px 22px -10px rgba(245,162,35,.9)}
.btn-buy:disabled{opacity:.55;cursor:not-allowed}
.back{display:inline-flex;align-items:center;gap:6px;color:rgba(255,255,255,.65);text-decoration:none;font-size:13px;font-weight:700;margin-bottom:10px}
</style>
</head>
<body>
<%- include('partials/topnav', { user: user }) %>

<div class="wrap">
  <a class="back" href="/"><span class="material-symbols-outlined" style="font-size:18px">arrow_back</span><%= t('common.back') %></a>

  <div class="room-head">
    <div class="rh-top">
      <div class="rh-name"><%= room.ticketLabel || t('join.full_ticket') %></div>
      <div class="rh-state <%= displayStatus === 'starting' ? 'starting' : '' %>">
        <span class="material-symbols-outlined" style="font-size:15px"><%= displayStatus === 'starting' ? 'hourglass_top' : 'group' %></span>
        <%= displayStatus === 'starting' ? t('join.starting') : t('join.waiting') %>
      </div>
    </div>
    <div class="rh-grid">
      <div class="rh-cell"><div class="rh-lbl"><%= t('join.entry_fee') %></div><div class="rh-val"><%= money(room.entryFee || 0) %></div></div>
      <div class="rh-cell"><div class="rh-lbl"><%= t('join.players') %></div><div class="rh-val"><%= playerCount %>/<%= roomSize %></div></div>
      <div class="rh-cell"><div class="rh-lbl"><%= t('join.prize') %></div><div class="rh-val"><%= money(ticketPrize || room.prize || 0) %></div></div>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %><div class="error-msg"><%= error %></div><% } %>

  <div class="sec-title"><%= t('join.ticket_count') %></div>
  <div class="qty" id="qtyBar">
    <% for (var q = 1; q <= maxTickets; q++) { %>
      <button type="button" data-q="<%= q %>" class="<%= q === 1 ? 'on' : '' %>"><%= q %></button>
    <% } %>
  </div>

  <div class="sec-title"><%= t('join.your_tickets') %></div>
  <div id="tickets">
    <% previewCards.forEach(function(card, i){ %>
      <div class="ticket" data-i="<%= i %>" style="<%= i === 0 ? '' : 'display:none' %>">
        <div class="t-head">
          <div class="t-name"><%= t('join.ticket') %> #<%= i + 1 %></div>
          <div class="t-price"><%= money(room.entryFee || 0) %></div>
        </div>
        <div class="grid9">
          <% card.forEach(function(row){ row.forEach(function(n){ %>
            <div class="cell <%= n ? '' : 'empty' %>"><%= n || '' %></div>
          <% }); }); %>
        </div>
      </div>
    <% }); %>
  </div>
</div>

<form method="POST" action="/join/<%= room._id %>" id="buyForm">
  <input type="hidden" name="tickets" id="ticketsInput">
  <input type="hidden" name="quantity" id="qtyInput" value="1">
  <div class="total-bar">
    <div class="total-inner">
      <div class="total-sum">
        <div class="ts-l"><%= t('join.total') %></div>
        <div class="ts-v" id="totalVal"><%= money(room.entryFee || 0) %></div>
      </div>
      <button type="submit" class="btn-buy" id="buyBtn"><%= t('join.buy') %></button>
    </div>
  </div>
</form>

<script>
(function(){
  var CARDS = <%- JSON.stringify(previewCards) %>;
  var FEE   = <%= Number(room.entryFee || 0) %>;
  var RATE  = <%= Number(localeMeta.rate || 1) %>;
  var SYM   = <%- JSON.stringify(localeMeta.symbol) %>;
  var qty = 1;

  function fmt(azn){ return (azn * RATE).toFixed(2) + ' ' + SYM; }

  function paint(){
    document.querySelectorAll('#qtyBar button').forEach(function(b){
      b.classList.toggle('on', Number(b.dataset.q) === qty);
    });
    document.querySelectorAll('#tickets .ticket').forEach(function(t){
      t.style.display = Number(t.dataset.i) < qty ? '' : 'none';
    });
    document.getElementById('totalVal').textContent = fmt(FEE * qty);
    document.getElementById('qtyInput').value = qty;
    document.getElementById('ticketsInput').value = JSON.stringify(CARDS.slice(0, qty));
  }

  document.getElementById('qtyBar').addEventListener('click', function(e){
    var b = e.target.closest('button[data-q]');
    if (!b) return;
    qty = Number(b.dataset.q) || 1;
    paint();
  });

  document.getElementById('buyForm').addEventListener('submit', function(){
    var btn = document.getElementById('buyBtn');
    btn.disabled = true;
    setTimeout(function(){ btn.disabled = false; }, 6000);
  });

  paint();
})();
</script>
<%- include('partials/footer', { activePage: 'home' }) %>
</body>
</html>
