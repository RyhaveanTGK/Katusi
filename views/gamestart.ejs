<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Oyun – One Loto</title>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/loto.css">
<style>
  body{ padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
  .bottombar{
    position:fixed; left:0; right:0; bottom:0; z-index:60;
    background: linear-gradient(180deg, rgba(30,8,55,.92) 0%, rgba(16,3,30,.99) 100%);
    border-top:1px solid rgba(245,197,24,.2);
    padding:10px 12px calc(10px + env(safe-area-inset-bottom));
  }
  .bottombar-inner{ max-width:480px; margin:0 auto; display:grid; grid-template-columns:minmax(0,1fr) auto; gap:10px; align-items:center; }
  .bb-info{ min-width:0; }
  .bb-k{ font-size:11px; color:rgba(255,255,255,.6); font-weight:700; text-transform:uppercase; }
  .bb-v{ font-size:16px; font-weight:900; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  /* ── Oyunçular / mərc paneli ── */
  .stat-pill .item.tap{ cursor:pointer; -webkit-tap-highlight-color:transparent; }
  .stat-pill .item.tap:active{ transform:scale(.94); }
  .stat-pill .item{ transition: transform .15s ease; position:relative; }
  #roomStake{ transition: color .25s ease, transform .25s ease; display:inline-block; }
  .stake-up #roomStake{ color:#4ce07a; transform:scale(1.14); }
  .stake-down #roomStake{ color:#ff7a7a; transform:scale(.92); }
  .stake-float{
    position:absolute; left:50%; top:0; transform:translate(-50%,0);
    font-size:12px; font-weight:900; pointer-events:none; opacity:0; white-space:nowrap;
    text-shadow:0 2px 6px rgba(0,0,0,.6); z-index:5;
  }
  .stake-float.up{ color:#4ce07a; animation: stake-up-anim 1.1s ease forwards; }
  .stake-float.down{ color:#ff7a7a; animation: stake-down-anim 1.1s ease forwards; }
  @keyframes stake-up-anim{ 0%{opacity:0;transform:translate(-50%,4px) scale(.8);} 25%{opacity:1;transform:translate(-50%,-14px) scale(1.05);} 100%{opacity:0;transform:translate(-50%,-30px) scale(1);} }
  @keyframes stake-down-anim{ 0%{opacity:0;transform:translate(-50%,-14px) scale(.8);} 25%{opacity:1;transform:translate(-50%,2px) scale(1.05);} 100%{opacity:0;transform:translate(-50%,18px) scale(1);} }

  .sheet-back{
    position:fixed; inset:0; z-index:200; background:rgba(10,2,20,.6);
    backdrop-filter:blur(4px); display:none; align-items:flex-end; justify-content:center;
  }
  .sheet-back.show{ display:flex; animation: fadein .2s ease; }
  @keyframes fadein{ from{opacity:0} to{opacity:1} }
  .sheet{
    width:100%; max-width:480px; background:linear-gradient(180deg,#2a0848 0%,#190430 100%);
    border:1px solid rgba(245,197,24,.25); border-bottom:none;
    border-radius:22px 22px 0 0; padding:16px 16px calc(20px + env(safe-area-inset-bottom));
    box-shadow:0 -12px 40px rgba(0,0,0,.6); animation: sheet-up .25s cubic-bezier(.2,.9,.3,1);
    max-height:70vh; overflow:auto;
  }
  @keyframes sheet-up{ from{ transform:translateY(100%);} to{ transform:none; } }
  .sheet-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
  .sheet-title{ font-size:16px; font-weight:900; display:flex; align-items:center; gap:8px; }
  .sheet-title .cnt{ font-size:12px; font-weight:800; color:#f5c518; background:rgba(245,197,24,.12); padding:3px 9px; border-radius:20px; }
  .sheet-x{ background:rgba(255,255,255,.1); border:none; color:#fff; width:32px; height:32px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .plist{ display:flex; flex-direction:column; gap:8px; }
  .prow{
    display:flex; align-items:center; gap:10px;
    background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.08);
    border-radius:14px; padding:9px 12px;
    animation: fade-in-row .25s ease both;
  }
  @keyframes fade-in-row{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;} }
  .prow.me{ border-color:rgba(245,197,24,.55); background:rgba(245,197,24,.1); }
  .pav{
    width:32px; height:32px; border-radius:50%; flex:0 0 32px;
    display:flex; align-items:center; justify-content:center;
    font-weight:900; font-size:13px; color:#1a0530;
    background:linear-gradient(180deg,#ffe27a,#e0a82e);
  }
  .pname{ font-size:14px; font-weight:800; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0; flex:1; }
  .ptick{ font-size:11px; font-weight:700; color:rgba(255,255,255,.55); }
  .pstake{ font-size:14px; font-weight:900; color:#4ce07a; margin-left:auto; white-space:nowrap; }
  .sheet-foot{
    margin-top:12px; padding-top:12px; border-top:1px dashed rgba(255,255,255,.18);
    display:flex; align-items:center; justify-content:space-between; font-weight:900; font-size:15px;
  }
  .sheet-foot span:last-child{ color:#f5c518; }
  /* ── Qalib animasiyası (vaxt bitdikdən sonra) ── */
  .win-overlay{
    position:fixed; inset:0; z-index:400; display:none;
    align-items:center; justify-content:center; padding:24px;
    background:radial-gradient(circle at 50% 45%, rgba(80,20,140,.85), rgba(8,1,16,.96));
    backdrop-filter:blur(6px);
  }
  .win-overlay.show{ display:flex; animation: wo-in .35s ease both; }
  @keyframes wo-in{ from{opacity:0} to{opacity:1} }
  .win-box{ text-align:center; max-width:420px; width:100%; }
  .win-word{
    font-size:64px; line-height:1; font-weight:900; letter-spacing:6px;
    background:linear-gradient(180deg,#fff6c9,#f5c518 55%,#c98a05);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    text-shadow:0 10px 40px rgba(245,197,24,.35);
    animation: win-pop .7s cubic-bezier(.2,1.4,.4,1) both;
  }
  @keyframes win-pop{ 0%{transform:scale(.3) rotate(-6deg);opacity:0} 60%{transform:scale(1.15) rotate(2deg);opacity:1} 100%{transform:scale(1) rotate(0)} }
  .win-name{
    margin-top:14px; font-size:26px; font-weight:900; color:#fff;
    animation: win-slide .5s .25s ease both; word-break:break-word;
  }
  .win-prize{
    margin-top:10px; display:inline-block; font-size:22px; font-weight:900; color:#1a0530;
    background:linear-gradient(180deg,#ffe27a,#e0a82e); padding:8px 20px; border-radius:999px;
    animation: win-slide .5s .4s ease both;
  }
  .win-sub{ margin-top:14px; font-size:13px; font-weight:700; color:rgba(255,255,255,.7); animation: win-slide .5s .55s ease both; }
  @keyframes win-slide{ from{opacity:0; transform:translateY(14px)} to{opacity:1; transform:none} }
  .win-rays{
    position:absolute; width:520px; height:520px; border-radius:50%;
    background:conic-gradient(from 0deg, rgba(245,197,24,.22) 0 12deg, transparent 12deg 30deg);
    animation: win-spin 9s linear infinite; pointer-events:none;
  }
  @keyframes win-spin{ to{ transform:rotate(360deg); } }
  .win-me{ margin-top:8px; font-size:14px; font-weight:800; color:#4ce07a; animation: win-slide .5s .6s ease both; }
  /* ── sol üst menyu / geri düyməsi ── */
  .room-menu{
    position:fixed; left:10px; top:calc(env(safe-area-inset-top) + 62px); z-index:120;
    width:42px; height:42px; border-radius:14px; border:1px solid rgba(245,197,24,.35);
    background:linear-gradient(180deg, rgba(60,20,110,.92), rgba(30,8,55,.95));
    color:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer;
    box-shadow:0 6px 18px rgba(0,0,0,.45);
  }
  .room-menu:active{ transform:scale(.94); }
  .menu-pop{
    position:fixed; left:10px; top:calc(env(safe-area-inset-top) + 110px); z-index:121;
    background:linear-gradient(180deg,#2a0848,#190430); border:1px solid rgba(245,197,24,.25);
    border-radius:14px; padding:6px; display:none; min-width:190px; box-shadow:0 12px 30px rgba(0,0,0,.55);
  }
  .menu-pop.show{ display:block; animation: fade-in-row .18s ease both; }
  .menu-pop a, .menu-pop button{
    display:flex; align-items:center; gap:8px; width:100%; text-align:left;
    background:none; border:none; color:#fff; font:inherit; font-weight:700; font-size:14px;
    padding:10px 12px; border-radius:10px; cursor:pointer; text-decoration:none;
  }
  .menu-pop a:active, .menu-pop button:active{ background:rgba(255,255,255,.08); }
  /* ── bilet sayğacı (animasiyalı) ── */
  .ticket-chip{
    display:inline-flex; align-items:center; gap:6px; margin-left:8px;
    background:rgba(245,197,24,.14); border:1px solid rgba(245,197,24,.4);
    color:#f5c518; font-size:12px; font-weight:900; padding:4px 10px; border-radius:999px;
    transition: transform .2s ease;
  }
  .ticket-chip .tc-n{ font-size:14px; }
  .ticket-chip.bump{ animation: tc-bump .5s cubic-bezier(.2,1.5,.4,1); }
  @keyframes tc-bump{ 0%{transform:scale(1)} 40%{transform:scale(1.35)} 100%{transform:scale(1)} }
  .tc-float{
    position:absolute; left:50%; top:-6px; transform:translateX(-50%);
    font-size:12px; font-weight:900; color:#4ce07a; pointer-events:none;
    animation: stake-up-anim 1.1s ease forwards;
  }
  /* ── təsdiq pəncərəsi ── */
  .confirm-back{ position:fixed; inset:0; z-index:500; background:rgba(8,1,16,.78); backdrop-filter:blur(5px); display:none; align-items:center; justify-content:center; padding:22px; }
  .confirm-back.show{ display:flex; animation: fadein .2s ease; }
  .confirm-box{ width:100%; max-width:360px; background:linear-gradient(180deg,#2a0848,#190430); border:1px solid rgba(245,197,24,.3); border-radius:20px; padding:20px; text-align:center; }
  .confirm-title{ font-size:18px; font-weight:900; margin-bottom:8px; }
  .confirm-text{ font-size:14px; font-weight:600; color:rgba(255,255,255,.78); line-height:1.5; }
  .confirm-actions{ display:flex; gap:10px; margin-top:18px; }
  .confirm-actions button{ flex:1; border:none; border-radius:14px; padding:12px; font-weight:900; font-size:14px; cursor:pointer; }
  .btn-stay{ background:rgba(255,255,255,.12); color:#fff; }
  .btn-leave{ background:linear-gradient(180deg,#ff8a8a,#d63a3a); color:#fff; }
  /* ── 3K (3D) oyun daşı ── */
  .ball{
    width:74px; height:74px;
    background:
      radial-gradient(circle at 30% 24%, #ffffff 0%, rgba(255,255,255,.85) 6%, rgba(255,246,207,.55) 14%, transparent 32%),
      radial-gradient(circle at 68% 78%, rgba(0,0,0,.35) 0%, transparent 45%),
      radial-gradient(circle at 40% 34%, #fff3bd 0%, #f5c518 42%, #d79b06 68%, #8d6100 100%);
    box-shadow:
      inset 0 -12px 18px rgba(90,48,0,.45),
      inset 0 8px 14px rgba(255,255,255,.55),
      0 14px 26px -6px rgba(0,0,0,.55),
      0 0 0 2px rgba(255,255,255,.08);
    text-shadow:0 1px 0 rgba(255,255,255,.6), 0 -1px 0 rgba(0,0,0,.25);
    transform-style:preserve-3d;
    animation: ball-float 3.4s ease-in-out infinite;
  }
  .ball::after{
    content:''; position:absolute; left:50%; bottom:-12px; transform:translateX(-50%);
    width:56px; height:12px; border-radius:50%;
    background:radial-gradient(ellipse, rgba(0,0,0,.45), transparent 70%);
    filter:blur(2px);
  }
  .ball.pop{ animation: ball-3d-pop .55s cubic-bezier(.2,1.3,.35,1); }
  /* Axıcı 3D çıxış: fırlanaraq yaxınlaşır, yumşaq oturur */
  @keyframes ball-3d-pop{
    0%   { transform: perspective(600px) translate3d(0,-38px,-160px) rotateX(-35deg) rotateY(-220deg) scale(.45); opacity:0; filter:blur(3px); }
    35%  { opacity:1; filter:blur(0); }
    62%  { transform: perspective(600px) translate3d(0,6px,0) rotateX(6deg) rotateY(-12deg) scale(1.12); }
    82%  { transform: perspective(600px) translate3d(0,-3px,0) rotateX(-2deg) rotateY(4deg) scale(.98); }
    100% { transform: perspective(600px) translate3d(0,0,0) rotateX(0) rotateY(0) scale(1); opacity:1; }
  }
  /* Fasiləsiz yumşaq süzülmə (donmadan) */
  @keyframes ball-float{
    0%   { transform: perspective(600px) translateY(0)    rotateY(0deg)   rotateX(0deg); }
    25%  { transform: perspective(600px) translateY(-5px) rotateY(8deg)   rotateX(3deg); }
    50%  { transform: perspective(600px) translateY(-7px) rotateY(0deg)   rotateX(0deg); }
    75%  { transform: perspective(600px) translateY(-5px) rotateY(-8deg)  rotateX(-3deg); }
    100% { transform: perspective(600px) translateY(0)    rotateY(0deg)   rotateX(0deg); }
  }
  .ball{ will-change: transform; }
  .draw-item{ animation: draw-in .35s cubic-bezier(.2,1.2,.35,1) both; }
  @keyframes draw-in{ from{ transform: translateY(-8px) scale(.6); opacity:0 } to{ transform:none; opacity:1 } }
  /* ── Vaxtında qoyulmayan daş: qırmızı X, bloklanıb ── */
  .cell.missed{
    position:relative; color:#d33 !important;
    background:#ffe1e1 !important; box-shadow:inset 0 0 0 2px rgba(214,58,58,.55) !important;
    cursor:not-allowed; opacity:.95;
  }
  .cell.missed::before,
  .cell.missed::after{
    content:''; position:absolute; left:12%; top:50%; width:76%; height:3px; border-radius:3px;
    background:#e03131;
  }
  .cell.missed::before{ transform: translateY(-50%) rotate(45deg); }
  .cell.missed::after{  transform: translateY(-50%) rotate(-45deg); }
  /* ── daşın qalan vaxtı (biletdə) ── */
  .cell.drawn.clickable{ animation: cell-urge 1s ease-in-out infinite; }
  @keyframes cell-urge{ 0%,100%{ box-shadow: inset 0 0 0 2px rgba(245,197,24,.75); } 50%{ box-shadow: inset 0 0 0 2px rgba(245,197,24,.25); } }
  /* ── oyun haqqında məlumat ── */
  .info-body{ font-size:14px; line-height:1.62; color:rgba(255,255,255,.86); font-weight:600; }
  .info-body h4{ margin:14px 0 6px; font-size:15px; font-weight:900; color:#f5c518; }
  .info-body ul{ margin:6px 0 0 18px; padding:0; }
  .info-body li{ margin-bottom:6px; }
  .info-body b{ color:#fff; }
  .info-note{ margin-top:14px; background:rgba(245,197,24,.1); border:1px solid rgba(245,197,24,.28); border-radius:14px; padding:10px 12px; font-size:13px; }
  .cell.marked{
    background: radial-gradient(circle at 32% 26%, #b9f7c8 0%, #45d766 40%, #16a62d 72%, #0a6a1e 100%) !important;
    box-shadow: inset 0 -3px 5px rgba(0,0,0,.35), inset 0 2px 3px rgba(255,255,255,.5), 0 2px 5px rgba(0,0,0,.25) !important;
    text-shadow:0 1px 1px rgba(0,0,0,.35);
  }
  .bb-home{
    flex:0 0 auto; text-decoration:none; color:#fff;
    background: rgba(255,255,255,.12); border-radius:14px;
    padding:12px 16px; font-weight:800; font-size:14px;
    display:flex; align-items:center; gap:6px;
  }
</style>
</head>
<body>

<%- include('partials/topnav', { user: user }) %>

<button class="room-menu" id="roomMenuBtn" type="button" aria-label="Menyu"><span class="material-symbols-outlined">menu</span></button>
<div class="menu-pop" id="roomMenuPop">
  <a href="/"><span class="material-symbols-outlined">home</span>Ana səhifə</a>
  <a href="/winners"><span class="material-symbols-outlined">emoji_events</span>Qaliblər</a>
  <button type="button" id="leaveBtn"><span class="material-symbols-outlined">logout</span>Oyundan çıx</button>
  <button type="button" id="infoBtn"><span class="material-symbols-outlined">help</span>Oyun haqqında məlumat</button>
</div>

<!-- Oyun haqqında tam məlumat -->
<div class="sheet-back" id="infoSheet">
  <div class="sheet">
    <div class="sheet-head">
      <div class="sheet-title">Oyun haqqında məlumat</div>
      <button class="sheet-x" id="infoClose" type="button" aria-label="Bağla"><span class="material-symbols-outlined">close</span></button>
    </div>
    <div class="info-body">
      <h4>Oyun necə oynanılır?</h4>
      <ul>
        <li>Hər otaqda <b>5 oyunçu</b> iştirak edir. Otaq dolduqda oyun avtomatik başlayır və eyni mərcli <b>yeni boş otaq</b> açılır. Başlamış oyuna sonradan heç kim daxil ola bilməz.</li>
        <li>Bilet <b>3 sıradan (linya)</b> ibarətdir, hər sırada <b>5 rəqəm</b>, cəmi <b>15 rəqəm</b> var. Bir oyunda maksimum <b>5 bilet</b> ala bilərsiniz.</li>
        <li>Oyun başlayanda hər bir neçə saniyədən bir <b>daş (1–90)</b> çıxır. Çıxan daş sizin biletinizdə varsa, üzərinə toxunub <b>özünüz yerləşdirməlisiniz</b>.</li>
        <li>Daşı yerləşdirmək üçün <b>məhdud vaxtınız</b> var. Vaxtında vurmasanız xana <b>qırmızı X</b> ilə bloklanır və həmin daş sizin üçün <b>sayılmır</b>.</li>
      </ul>

      <h4>Qazanc necə hesablanır?</h4>
      <ul>
        <li>Otaqdakı bütün oyunçuların mərcləri <b>ümumi banka</b> yığılır (yuxarıdakı kubok işarəsinin yanındakı əsas mərc).</li>
        <li><b>1-ci linyanı</b> tam dolduran ilk oyunçu bankın <b>8%-ini</b> qazanır.</li>
        <li><b>2-ci linya</b> üçün <b>16%</b>, <b>3-cü linya</b> üçün <b>24%</b> ödənilir.</li>
        <li>Hər linya uduşu dərhal həmin oyunçunun <b>balansına köçürülür</b> və eyni məbləğ ortadakı <b>bankdan çıxılır</b>.</li>
        <li>Bileti <b>tam dolduran ilk oyunçu qalibdir</b> və bankda qalan <b>bütün məbləği</b> qazanır.</li>
        <li>Vaxt bitənədək heç kim bileti tam doldurmasa, <b>ən çox linya və daş</b> yığan oyunçu qalib sayılır və qalan bankı alır.</li>
      </ul>

      <h4>Otaq qaydaları</h4>
      <ul>
        <li>Otaqda <b>3 və daha çox real oyunçu</b> olarsa, oyun bitənədək otağa <b>bot əlavə olunmur</b> — yalnız real istifadəçilər oynayır.</li>
        <li>Oyundan vaxtından əvvəl çıxsanız mərcinizin <b>70%-i komissiya</b> kimi tutulur, <b>30%-i</b> balansınıza qaytarılır.</li>
        <li>Oyun bitdikdən sonra otaq avtomatik təmizlənir və yeni raunda hazırlanır.</li>
      </ul>

      <div class="info-note">Məsləhət: səsi açıq saxlayın — hər yeni daş çıxanda siqnal verilir və daşı vaxtında yerləşdirmək asanlaşır.</div>
    </div>
  </div>
</div>

<div class="confirm-back" id="leaveConfirm">
  <div class="confirm-box">
    <div class="confirm-title">Oyundan çıxmaq istəyirsiniz?</div>
    <div class="confirm-text">
      Oyunu tərk etsəniz mərcinizdən <b>70% komissiya</b> tutulacaq və qalan <b>30%</b> balansınıza geri yüklənəcək.
    </div>
    <div class="confirm-actions">
      <button type="button" class="btn-stay" id="leaveCancel">Oyunda qal</button>
      <button type="button" class="btn-leave" id="leaveOk">Çıx (30% geri)</button>
    </div>
  </div>
</div>

<div class="gamebar">
  <div class="statbar">
    <div class="stat-pill">
      <div class="bet"><%= Number(room.entryFee || 0).toFixed(2) %><span class="mult"><%= room.prizeMultiplier || 'x2' %></span></div>
      <div class="item tap" id="playersBtn" role="button" tabindex="0" aria-label="Oyunçular"><span class="material-symbols-outlined">person</span><span id="playerCount"><%= playerCount || room.players.length %></span></div>
      <div class="sep"></div>
      <div class="item" id="ticketChipWrap" style="position:relative"><span class="ticket-chip" id="ticketChip"><span class="material-symbols-outlined" style="font-size:15px">confirmation_number</span><span class="tc-n" id="ticketChipCount"><%= cards.length %></span></span></div>
      <div class="sep"></div>
      <div class="item" id="stakeItem"><span class="material-symbols-outlined">emoji_events</span><span id="roomStake"><%= Number(totalStake || 0).toFixed(2) %></span><span>&nbsp;₼</span></div>
    </div>
    <button class="icon-btn" id="soundBtn" type="button" aria-label="Səs"><span class="material-symbols-outlined" id="soundIcon">volume_up</span></button>
  </div>
</div>

<div class="wrap">
  <div class="panel">
    <div class="panel-title">Canlı oyun</div>
    <div class="live-row">
      <div style="display:flex;flex-direction:column;gap:8px;min-width:0;">
        <div class="status-pill"><span class="status-dot"></span><span id="statusText"><%= displayStatus === 'started' ? 'Oyun başladı' : displayStatus === 'starting' ? 'Başlayır' : 'Gözləyir' %></span></div>
        <div class="timer" id="timer" data-secs="<%= secsLeft %>">00:00</div>
      </div>
      <div class="ball" id="currentBall"><%= room.currentNumber || '?' %></div>
    </div>
    <div class="draw-list" id="drawList"></div>
  </div>

  <div id="ticketList"></div>

  <div class="win-banner" id="winBanner" style="display:none"></div>
</div>

<div class="bottombar">
  <div class="bottombar-inner">
    <div class="bb-info">
      <div class="bb-k">Bilet uduşu</div>
      <div class="bb-v"><span id="ticketPrize"><%= Number(ticketPrize || 0).toFixed(2) %></span> ₼ · <span id="ticketCount"><%= cards.length %></span> bilet</div>
    </div>
    <a class="bb-home" href="/"><span class="material-symbols-outlined">home</span>Ana səhifə</a>
  </div>
</div>

<!-- Oyunçular siyahısı -->
<div class="sheet-back" id="playersSheet">
  <div class="sheet">
    <div class="sheet-head">
      <div class="sheet-title">Oyunçular <span class="cnt" id="sheetCount">0</span></div>
      <button class="sheet-x" id="sheetClose" type="button" aria-label="Bağla"><span class="material-symbols-outlined">close</span></button>
    </div>
    <div class="plist" id="playersList"></div>
    <div class="sheet-foot"><span>Ümumi mərc</span><span id="sheetTotal">0.00 ₼</span></div>
  </div>
</div>

<!-- Qalib elanı: yalnız vaxt bitdikdən sonra -->
<div class="win-overlay" id="winOverlay">
  <div class="win-rays"></div>
  <div class="win-box">
    <div class="win-word">WIN</div>
    <div class="win-name" id="winName"></div>
    <div class="win-prize" id="winPrize"></div>
    <div class="win-sub" id="winSub">Raund tamamlandı</div>
    <div class="win-me" id="winMe" style="display:none">Uduş balansınıza əlavə olundu</div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="/assets/js/loto-sound.js"></script>
<script>
var ROOM_ID = '<%= room._id %>';
var cards = <%- JSON.stringify(cards.map(function(c){ return { id: String(c._id), numbers: c.numbers, marked: c.markedNumbers || [], missed: [], isWinner: !!c.isWinner, lineWins: Number(c.lineWins || 0), prize: Number(c.prize || 0) }; })) %>;
var drawnNumbers = <%- JSON.stringify(room.drawnNumbers || []) %>;
var lastBall = <%- JSON.stringify(room.currentNumber || null) %>;
var lastRound = <%= Number(room.currentRoundId || 1) %>;
var MY_NAME = <%- JSON.stringify(user.username) %>;
var GRACE_MS = 12000;     // daşı biletə qoymaq üçün verilən vaxt
var seenAt   = {};        // daşın ilk görünmə vaxtı (client)
var lastStake = Number('<%= Number(totalStake || 0) %>') || 0;
var roster = [];

function toast(msg){
  var el = document.getElementById('toast');
  el.textContent = msg; el.classList.add('show');
  clearTimeout(window.__t); window.__t = setTimeout(function(){ el.classList.remove('show'); }, 2400);
}
function fmtTime(s){ s = Math.max(0, parseInt(s || 0, 10)); var m = Math.floor(s/60), ss = s%60; return (m<10?'0':'')+m+':'+(ss<10?'0':'')+ss; }
function statusLabel(s){ return s === 'started' ? 'Oyun başladı' : s === 'ended' ? 'Raund bitdi' : s === 'starting' ? 'Başlayır' : 'Gözləyir'; }
function renderTimer(){
  var t = document.getElementById('timer');
  var v = parseInt(t.dataset.secs || '0', 10);
  t.textContent = fmtTime(v);
  if (v > 0) t.dataset.secs = v - 1;
}
setInterval(renderTimer, 1000); renderTimer();

function renderDrawList(){
  var box = document.getElementById('drawList');
  box.innerHTML = '';
  // çıxan daşlar alt-alta yox, soldan sağa bir sıra ilə düzülür
  drawnNumbers.forEach(function(n, i, arr){
    var d = document.createElement('div');
    d.className = 'draw-item' + (i === arr.length - 1 ? ' latest' : '');
    d.textContent = n;
    box.appendChild(d);
  });
  box.scrollLeft = box.scrollWidth;
}

/* ── Daş vaxtı: vaxtında vurulmayan daş bloklanır (qırmızı X) ── */
function trackDrawn(){
  var now = Date.now();
  drawnNumbers.forEach(function(n){ if (!seenAt[n]) seenAt[n] = now; });
}
function isExpired(n){
  var t = seenAt[n];
  return !!t && (Date.now() - t) > GRACE_MS;
}
function isMissed(card, n){
  if (!n) return false;
  if ((card.marked || []).indexOf(n) >= 0) return false;
  if (drawnNumbers.indexOf(n) < 0) return false;
  if ((card.missed || []).indexOf(n) >= 0) return true;
  return isExpired(n);
}
/* Xanaların vəziyyətini saniyəlik yenilə (yenidən qurmadan) */
function refreshCellStates(){
  var list = document.getElementById('ticketList');
  if (!list) return;
  cards.forEach(function(card){
    var box = list.querySelector('[data-card-id="' + card.id + '"]');
    if (!box) return;
    box.querySelectorAll('.cell').forEach(function(cell){
      var n = Number(cell.dataset.number || 0);
      if (!n || cell.classList.contains('marked')) return;
      if (isMissed(card, n)){
        cell.classList.remove('clickable', 'drawn');
        cell.classList.add('missed');
      }
    });
  });
}
setInterval(refreshCellStates, 500);

/* ── Oyunçular siyahısı (person düyməsi) ── */
function renderPlayers(data){
  if (data && Array.isArray(data.players)) roster = data.players;
  var list = document.getElementById('playersList');
  var cnt  = document.getElementById('sheetCount');
  var tot  = document.getElementById('sheetTotal');
  if (!list) return;

  cnt.textContent = roster.length;
  var sum = 0;
  list.innerHTML = '';
  roster.forEach(function(p){
    sum += Number(p.stake || 0);
    var row = document.createElement('div');
    row.className = 'prow' + (p.name === MY_NAME ? ' me' : '');
    row.innerHTML =
      '<span class="pav">' + String(p.name || '?').charAt(0).toUpperCase() + '</span>' +
      '<span class="pname">' + (p.name || 'Oyunçu') + (p.name === MY_NAME ? ' (siz)' : '') + '</span>' +
      '<span class="ptick">' + Number(p.tickets || 1) + ' bilet</span>' +
      '<span class="pstake">' + Number(p.stake || 0).toFixed(2) + ' ₼</span>';
    list.appendChild(row);
  });
  if (!roster.length) list.innerHTML = '<div class="prow"><span class="pname">Oyunçular gözlənilir…</span></div>';
  tot.textContent = sum.toFixed(2) + ' ₼';
}

/* ── Ümumi mərc: + / − animasiyalı ── */
function setStake(value){
  var item = document.getElementById('stakeItem');
  var el   = document.getElementById('roomStake');
  if (!item || !el) return;
  value = Number(value || 0);
  var delta = Number((value - lastStake).toFixed(2));
  if (Math.abs(delta) < 0.005){ el.textContent = value.toFixed(2); lastStake = value; return; }

  var f = document.createElement('span');
  f.className = 'stake-float ' + (delta > 0 ? 'up' : 'down');
  f.textContent = (delta > 0 ? '+' : '−') + Math.abs(delta).toFixed(2) + ' ₼';
  item.appendChild(f);
  setTimeout(function(){ if (f.parentNode) f.parentNode.removeChild(f); }, 1200);

  item.classList.remove('stake-up','stake-down');
  void item.offsetWidth;
  item.classList.add(delta > 0 ? 'stake-up' : 'stake-down');
  setTimeout(function(){ item.classList.remove('stake-up','stake-down'); }, 700);

  var from = lastStake, start = performance.now(), dur = 700;
  lastStake = value;
  (function step(now){
    var t = Math.min(1, (now - start) / dur);
    var e = 1 - Math.pow(1 - t, 3);
    el.textContent = (from + delta * e).toFixed(2);
    if (t < 1) requestAnimationFrame(step); else el.textContent = value.toFixed(2);
  })(start);
}

(function(){
  var btn = document.getElementById('playersBtn');
  var back = document.getElementById('playersSheet');
  var close = document.getElementById('sheetClose');
  if (!btn || !back) return;
  function open(){ renderPlayers(); back.classList.add('show'); }
  function hide(){ back.classList.remove('show'); }
  btn.addEventListener('click', open);
  btn.addEventListener('keypress', function(e){ if (e.key === 'Enter') open(); });
  close.addEventListener('click', hide);
  back.addEventListener('click', function(e){ if (e.target === back) hide(); });
})();

/* ── Bilet sayı: animasiyalı (+/-) göstərici ── */
var lastTicketCount = <%= cards.length %>;
function setTicketChip(n){
  var chip = document.getElementById('ticketChip');
  var cnt  = document.getElementById('ticketChipCount');
  var wrap = document.getElementById('ticketChipWrap');
  if (!chip || !cnt) return;
  n = Number(n || 0);
  cnt.textContent = n;
  if (n === lastTicketCount) return;
  var delta = n - lastTicketCount;
  lastTicketCount = n;
  chip.classList.remove('bump'); void chip.offsetWidth; chip.classList.add('bump');
  if (wrap){
    var f = document.createElement('span');
    f.className = 'tc-float';
    f.textContent = (delta > 0 ? '+' : '−') + Math.abs(delta);
    f.style.color = delta > 0 ? '#4ce07a' : '#ff7a7a';
    wrap.appendChild(f);
    setTimeout(function(){ if (f.parentNode) f.parentNode.removeChild(f); }, 1200);
  }
}

/* ── Sol üst menyu + oyundan çıxış ── */
(function(){
  var btn = document.getElementById('roomMenuBtn');
  var pop = document.getElementById('roomMenuPop');
  var leave = document.getElementById('leaveBtn');
  var back = document.getElementById('leaveConfirm');
  var cancel = document.getElementById('leaveCancel');
  var ok = document.getElementById('leaveOk');
  if (!btn || !pop) return;
  btn.addEventListener('click', function(e){ e.stopPropagation(); pop.classList.toggle('show'); });
  document.addEventListener('click', function(e){ if (!pop.contains(e.target) && e.target !== btn) pop.classList.remove('show'); });
  var info = document.getElementById('infoBtn');
  var infoBack = document.getElementById('infoSheet');
  var infoClose = document.getElementById('infoClose');
  if (info && infoBack){
    info.addEventListener('click', function(){ pop.classList.remove('show'); infoBack.classList.add('show'); });
    infoClose.addEventListener('click', function(){ infoBack.classList.remove('show'); });
    infoBack.addEventListener('click', function(e){ if (e.target === infoBack) infoBack.classList.remove('show'); });
  }
  leave.addEventListener('click', function(){ pop.classList.remove('show'); back.classList.add('show'); });
  cancel.addEventListener('click', function(){ back.classList.remove('show'); });
  back.addEventListener('click', function(e){ if (e.target === back) back.classList.remove('show'); });
  ok.addEventListener('click', function(){
    ok.disabled = true;
    fetch('/api/room/' + ROOM_ID + '/leave', { method:'POST', headers:{'Content-Type':'application/json'}, body:'{}' })
      .then(function(r){ return r.json(); })
      .then(function(res){
        if (res.error){ ok.disabled = false; toast(res.error); return; }
        toast('Balansınıza ' + Number(res.refund || 0).toFixed(2) + ' ₼ qaytarıldı');
        setTimeout(function(){ window.location.href = '/'; }, 900);
      })
      .catch(function(){ ok.disabled = false; toast('Şəbəkə xətası'); });
  });
})();

function ticketNode(card, index){
  var total = 0, marks = 0;
  var box = document.createElement('div');
  box.className = 'ticket' + (card.isWinner ? ' won' : '');
  box.dataset.cardId = card.id;

  var head = document.createElement('div');
  head.className = 'ticket-foot';
  head.style.marginTop = '0';
  head.style.marginBottom = '8px';
  head.innerHTML = '<span class="ticket-no">Bilet #' + (index + 1) + '</span>';
  box.appendChild(head);

  var grid = document.createElement('div');
  grid.className = 'grid';
  var markedSet = {};
  (card.marked || []).forEach(function(n){ markedSet[Number(n)] = true; });

  card.numbers.forEach(function(row){
    row.forEach(function(n){
      var cell = document.createElement('div');
      var isDrawn = n && drawnNumbers.indexOf(n) >= 0;
      var isMarked = n && markedSet[n];
      var missed = !!n && !isMarked && isMissed(card, n);
      if (n) { total++; if (isMarked) marks++; }
      cell.className = 'cell' + (n ? '' : ' empty') +
        (isDrawn && !isMarked && !missed ? ' drawn clickable' : '') +
        (isMarked ? ' marked' : '') +
        (missed ? ' missed' : '');
      cell.dataset.number = n || '';
      cell.textContent = n || '';
      grid.appendChild(cell);
    });
  });
  box.appendChild(grid);

  var foot = document.createElement('div');
  foot.className = 'ticket-foot';
  foot.innerHTML = '<span>' + marks + '/' + total + '</span><span class="progress"><i style="width:' +
    (total ? Math.round(marks / total * 100) : 0) + '%"></i></span>' +
    (card.isWinner ? '<span class="win-tag">' + Number(card.lineWins || 1) + ' linya · +' + Number(card.prize || 0).toFixed(2) + ' ₼</span>' : '<span></span>');
  box.appendChild(foot);

  grid.addEventListener('click', function(e){
    var cell = e.target.closest('.cell.clickable');
    if (!cell || !cell.dataset.number) return;
    var number = Number(cell.dataset.number);
    if (isMissed(card, number)) { toast('Vaxt bitdi — bu daş bloklandı'); return; }
    cell.classList.remove('clickable', 'drawn');
    cell.classList.add('marked');
    LotoSound.place();
    fetch('/api/card/' + ROOM_ID + '/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ number: number, cardId: card.id })
    }).then(function(r){ return r.json(); }).then(function(res){
      if (res.error) {
        toast(res.error);
        if (res.missed) { card.missed = (card.missed || []).concat([number]); renderTickets(); }
        return poll();
      }
      if (res.card) { card.marked = res.card.marked_numbers || []; }
      if (typeof res.balance === 'number' && window.animateBalance) window.animateBalance(res.balance);
      if (res.card) { card.isWinner = !!res.card.is_winner; card.lineWins = Number(res.card.line_wins || 0); card.prize = Number(res.card.prize || 0); }
      if (res.won && Number(res.prize || 0) > 0) {
        LotoSound.win();
        showWin(res.prize || 0, Number(res.card && res.card.line_wins || 0));
      }
      if (res.full) { setTimeout(poll, 600); }
      renderTickets();
    }).catch(function(){ toast('Şəbəkə xətası'); poll(); });
  });

  return box;
}

function renderTickets(){
  var list = document.getElementById('ticketList');
  list.innerHTML = '';
  cards.forEach(function(c, i){ list.appendChild(ticketNode(c, i)); });
  document.getElementById('ticketCount').textContent = cards.length;
  setTicketChip(cards.length);
}

function showWin(prize, lineNo){
  var b = document.getElementById('winBanner');
  var pct = [8, 16, 24][Math.min(Math.max(1, Number(lineNo || 1)), 3) - 1];
  b.style.display = 'block';
  b.innerHTML = Number(lineNo || 1) + '-ci linya doldu! <b>+' + Number(prize || 0).toFixed(2) + ' ₼</b> (' + pct + '%) balansına əlavə olundu.' +
    '<br><span style="font-weight:600;font-size:13px;opacity:.85">Bileti tam doldursanız qalib elan olunursunuz.</span>';
  toast('Qazandınız! +' + Number(prize || 0).toFixed(2) + ' ₼');
}

var winShown = false;
function showFinalWinner(w){
  if (!w || winShown) return;
  winShown = true;
  var ov = document.getElementById('winOverlay');
  document.getElementById('winName').textContent = w.name || 'Oyunçu';
  var amount = Number(w.prize || 0);
  document.getElementById('winPrize').textContent = (amount > 0 ? '+' : '') + amount.toFixed(2) + ' \u20BC';
  document.getElementById('winSub').textContent = w.full
    ? 'Bileti tam dolduran ilk oyunçu'
    : 'Ən çox linya dolduran oyunçu · ' + Number(w.lines || 0) + ' linya · ' + Number(w.marks || 0) + ' daş';
  document.getElementById('winMe').style.display = (w.name === MY_NAME) ? 'block' : 'none';
  ov.classList.add('show');
  if (window.LotoSound && LotoSound.win) LotoSound.win();
}

function syncState(data){
  if (!data || data.error) return;

  if (Number(data.current_round_id) !== lastRound) { window.location.reload(); return; }

  document.getElementById('playerCount').textContent = data.player_count;
  setStake(Number(data.total_stake || 0));
  document.getElementById('ticketPrize').textContent = Number(data.ticket_prize || 0).toFixed(2);
  if (Number(data.mark_grace_sec || 0) > 0) GRACE_MS = Number(data.mark_grace_sec) * 1000;
  document.getElementById('statusText').textContent = statusLabel(data.status);
  document.getElementById('timer').dataset.secs = data.secs_left || 0;

  var ball = document.getElementById('currentBall');
  if (data.current_number && data.current_number !== lastBall) {
    lastBall = data.current_number;
    ball.textContent = data.current_number;
    ball.classList.remove('pop'); void ball.offsetWidth; ball.classList.add('pop');
    LotoSound.draw();
  } else if (!data.current_number) {
    ball.textContent = '?';
  }

  drawnNumbers = data.drawn_numbers || drawnNumbers;
  trackDrawn();
  renderDrawList();
  renderPlayers(data);
  if (typeof data.balance === 'number' && window.animateBalance && Math.abs(window.getBalance() - data.balance) >= 0.005) {
    window.animateBalance(data.balance);
  }

  if (Array.isArray(data.cards) && data.cards.length) {
    cards = data.cards.map(function(c){
      return { id: c.id, numbers: c.numbers, marked: c.marked_numbers || [], missed: c.missed_numbers || [], isWinner: !!c.is_winner, lineWins: Number(c.line_wins || 0), prize: Number(c.prize || 0) };
    });
  }
  renderTickets();

  if (data.status === 'ended' && data.final_winner) showFinalWinner(data.final_winner);
}

function poll(){
  return fetch('/api/room/' + ROOM_ID).then(function(r){ return r.json(); }).then(syncState).catch(function(){});
}

/* ── səs aç/bağla ── */
(function(){
  var btn = document.getElementById('soundBtn');
  var icon = document.getElementById('soundIcon');
  function paint(){ icon.textContent = LotoSound.isOn() ? 'volume_up' : 'volume_off'; }
  paint();
  btn.addEventListener('click', function(){
    var on = LotoSound.toggle();
    paint();
    toast(on ? 'Səs açıldı' : 'Səs bağlandı');
  });
})();

renderDrawList();
trackDrawn();
renderTickets();
poll();
setInterval(poll, 2000);
</script>
</body>
</html>
