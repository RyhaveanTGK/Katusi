<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Oyun – One Loto</title>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/loto.css">
<style>
  body{ padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
  .bottombar{
    position:fixed; left:0; right:0; bottom:0; z-index:60;
    background: linear-gradient(180deg, rgba(30,8,55,.92) 0%, rgba(16,3,30,.99) 100%);
    border-top:1px solid rgba(245,197,24,.2);
    padding:10px 12px calc(10px + env(safe-area-inset-bottom));
  }
  .bottombar-inner{ max-width:480px; margin:0 auto; display:grid; grid-template-columns:minmax(0,1fr) auto; gap:10px; align-items:center; }
  .bb-info{ min-width:0; }
  .bb-k{ font-size:11px; color:rgba(255,255,255,.6); font-weight:700; text-transform:uppercase; }
  .bb-v{ font-size:16px; font-weight:900; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .bb-home{
    flex:0 0 auto; text-decoration:none; color:#fff;
    background: rgba(255,255,255,.12); border-radius:14px;
    padding:12px 16px; font-weight:800; font-size:14px;
    display:flex; align-items:center; gap:6px;
  }
</style>
</head>
<body>

<%- include('partials/topnav', { user: user }) %>

<div class="gamebar">
  <div class="statbar">
    <div class="stat-pill">
      <div class="bet"><%= Number(room.entryFee || 0).toFixed(2) %><span class="mult"><%= room.prizeMultiplier || 'x2' %></span></div>
      <div class="item"><span class="material-symbols-outlined">person</span><span id="playerCount"><%= room.players.length %></span></div>
      <div class="sep"></div>
      <div class="item"><span class="material-symbols-outlined">emoji_events</span><span id="roomPrize"><%= Number(ticketPrize || 0).toFixed(2) %> ₼</span></div>
    </div>
    <button class="icon-btn" id="soundBtn" type="button" aria-label="Səs"><span class="material-symbols-outlined" id="soundIcon">volume_up</span></button>
  </div>
</div>

<div class="wrap">
  <div class="panel">
    <div class="panel-title">Canlı oyun</div>
    <div class="live-row">
      <div style="display:flex;flex-direction:column;gap:8px;min-width:0;">
        <div class="status-pill"><span class="status-dot"></span><span id="statusText"><%= displayStatus === 'started' ? 'Oyun başladı' : displayStatus === 'starting' ? 'Başlayır' : 'Gözləyir' %></span></div>
        <div class="timer" id="timer" data-secs="<%= secsLeft %>">00:00</div>
      </div>
      <div class="ball" id="currentBall"><%= room.currentNumber || '?' %></div>
    </div>
    <div class="draw-list" id="drawList"></div>
  </div>

  <div id="ticketList"></div>

  <div class="win-banner" id="winBanner" style="display:none"></div>
  <div class="hint">Çıxan daşı biletdə vurub yerləşdir. Bilet tam dolduqda uduş <b>avtomatik</b> balansına əlavə olunur.</div>
</div>

<div class="bottombar">
  <div class="bottombar-inner">
    <div class="bb-info">
      <div class="bb-k">Bilet uduşu</div>
      <div class="bb-v"><span id="ticketPrize"><%= Number(ticketPrize || 0).toFixed(2) %></span> ₼ · <span id="ticketCount"><%= cards.length %></span> bilet</div>
    </div>
    <a class="bb-home" href="/"><span class="material-symbols-outlined">home</span>Ana səhifə</a>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="/assets/js/loto-sound.js"></script>
<script>
var ROOM_ID = '<%= room._id %>';
var cards = <%- JSON.stringify(cards.map(function(c){ return { id: String(c._id), numbers: c.numbers, marked: c.markedNumbers || [], isWinner: !!c.isWinner, prize: Number(c.prize || 0) }; })) %>;
var drawnNumbers = <%- JSON.stringify(room.drawnNumbers || []) %>;
var lastBall = <%- JSON.stringify(room.currentNumber || null) %>;
var lastRound = <%= Number(room.currentRoundId || 1) %>;

function toast(msg){
  var el = document.getElementById('toast');
  el.textContent = msg; el.classList.add('show');
  clearTimeout(window.__t); window.__t = setTimeout(function(){ el.classList.remove('show'); }, 2400);
}
function fmtTime(s){ s = Math.max(0, parseInt(s || 0, 10)); var m = Math.floor(s/60), ss = s%60; return (m<10?'0':'')+m+':'+(ss<10?'0':'')+ss; }
function statusLabel(s){ return s === 'started' ? 'Oyun başladı' : s === 'starting' ? 'Başlayır' : 'Gözləyir'; }
function renderTimer(){
  var t = document.getElementById('timer');
  var v = parseInt(t.dataset.secs || '0', 10);
  t.textContent = fmtTime(v);
  if (v > 0) t.dataset.secs = v - 1;
}
setInterval(renderTimer, 1000); renderTimer();

function renderDrawList(){
  var box = document.getElementById('drawList');
  box.innerHTML = '';
  drawnNumbers.slice(-14).forEach(function(n, i, arr){
    var d = document.createElement('div');
    d.className = 'draw-item' + (i === arr.length - 1 ? ' latest' : '');
    d.textContent = n;
    box.appendChild(d);
  });
}

function ticketNode(card, index){
  var total = 0, marks = 0;
  var box = document.createElement('div');
  box.className = 'ticket' + (card.isWinner ? ' won' : '');
  box.dataset.cardId = card.id;

  var head = document.createElement('div');
  head.className = 'ticket-foot';
  head.style.marginTop = '0';
  head.style.marginBottom = '8px';
  head.innerHTML = '<span class="ticket-no">Bilet #' + (index + 1) + '</span>';
  box.appendChild(head);

  var grid = document.createElement('div');
  grid.className = 'grid';
  var markedSet = {};
  (card.marked || []).forEach(function(n){ markedSet[Number(n)] = true; });

  card.numbers.forEach(function(row){
    row.forEach(function(n){
      var cell = document.createElement('div');
      var isDrawn = n && drawnNumbers.indexOf(n) >= 0;
      var isMarked = n && markedSet[n];
      if (n) { total++; if (isMarked) marks++; }
      cell.className = 'cell' + (n ? '' : ' empty') + (isDrawn && !isMarked ? ' drawn clickable' : '') + (isMarked ? ' marked' : '');
      cell.dataset.number = n || '';
      cell.textContent = n || '';
      grid.appendChild(cell);
    });
  });
  box.appendChild(grid);

  var foot = document.createElement('div');
  foot.className = 'ticket-foot';
  foot.innerHTML = '<span>' + marks + '/' + total + '</span><span class="progress"><i style="width:' +
    (total ? Math.round(marks / total * 100) : 0) + '%"></i></span>' +
    (card.isWinner ? '<span class="win-tag">Qazandı +' + Number(card.prize || 0).toFixed(2) + ' ₼</span>' : '<span></span>');
  box.appendChild(foot);

  grid.addEventListener('click', function(e){
    var cell = e.target.closest('.cell.clickable');
    if (!cell || !cell.dataset.number) return;
    var number = Number(cell.dataset.number);
    cell.classList.remove('clickable', 'drawn');
    cell.classList.add('marked');
    LotoSound.place();
    fetch('/api/card/' + ROOM_ID + '/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ number: number, cardId: card.id })
    }).then(function(r){ return r.json(); }).then(function(res){
      if (res.error) { toast(res.error); return poll(); }
      if (res.card) { card.marked = res.card.marked_numbers || []; }
      if (res.won) {
        card.isWinner = true;
        card.prize = res.prize || 0;
        LotoSound.win();
        showWin(res.prize || 0);
      }
      renderTickets();
    }).catch(function(){ toast('Şəbəkə xətası'); poll(); });
  });

  return box;
}

function renderTickets(){
  var list = document.getElementById('ticketList');
  list.innerHTML = '';
  cards.forEach(function(c, i){ list.appendChild(ticketNode(c, i)); });
  document.getElementById('ticketCount').textContent = cards.length;
}

function showWin(prize){
  var b = document.getElementById('winBanner');
  var pending = cards.filter(function(c){ return !c.isWinner; }).length;
  b.style.display = 'block';
  b.innerHTML = '🎉 Bilet tam doldu! <b>+' + Number(prize || 0).toFixed(2) + ' ₼</b> balansına əlavə olundu.' +
    (pending ? '<br><span style="font-weight:600;font-size:13px;opacity:.85">Qalan ' + pending + ' biletin dolması gözlənilir…</span>' : '');
  toast('Qazandınız! +' + Number(prize || 0).toFixed(2) + ' ₼');
}

function syncState(data){
  if (!data || data.error) return;

  if (Number(data.current_round_id) !== lastRound) { window.location.reload(); return; }

  document.getElementById('playerCount').textContent = data.player_count;
  document.getElementById('roomPrize').textContent = Number(data.ticket_prize || 0).toFixed(2) + ' ₼';
  document.getElementById('ticketPrize').textContent = Number(data.ticket_prize || 0).toFixed(2);
  document.getElementById('statusText').textContent = statusLabel(data.status);
  document.getElementById('timer').dataset.secs = data.secs_left || 0;

  var ball = document.getElementById('currentBall');
  if (data.current_number && data.current_number !== lastBall) {
    lastBall = data.current_number;
    ball.textContent = data.current_number;
    ball.classList.remove('pop'); void ball.offsetWidth; ball.classList.add('pop');
    LotoSound.draw();
  } else if (!data.current_number) {
    ball.textContent = '?';
  }

  drawnNumbers = data.drawn_numbers || drawnNumbers;
  renderDrawList();

  if (Array.isArray(data.cards) && data.cards.length) {
    cards = data.cards.map(function(c){
      return { id: c.id, numbers: c.numbers, marked: c.marked_numbers || [], isWinner: !!c.is_winner, prize: Number(c.prize || 0) };
    });
  }
  renderTickets();
}

function poll(){
  return fetch('/api/room/' + ROOM_ID).then(function(r){ return r.json(); }).then(syncState).catch(function(){});
}

/* ── səs aç/bağla ── */
(function(){
  var btn = document.getElementById('soundBtn');
  var icon = document.getElementById('soundIcon');
  function paint(){ icon.textContent = LotoSound.isOn() ? 'volume_up' : 'volume_off'; }
  paint();
  btn.addEventListener('click', function(){
    var on = LotoSound.toggle();
    paint();
    toast(on ? 'Səs açıldı' : 'Səs bağlandı');
  });
})();

renderDrawList();
renderTickets();
poll();
setInterval(poll, 2000);
</script>
</body>
</html>
