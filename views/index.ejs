<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#3d0d62">
<title>Oyun Kartları – One Loto</title>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<style>
/* ── Reset & responsive base ── */
*{ box-sizing:border-box; margin:0; padding:0; }
html, body{ overflow-x:hidden; max-width:100%; -webkit-text-size-adjust:100%; }
body{
  font-family:'Rubik','Segoe UI',Tahoma,Arial,sans-serif;
  background:#3d0d62; color:#fff;
  padding: 80px 10px 24px;   /* yalnız üstdən topnav üçün yer buraxırıq — alt footer normal axında */
  min-height: 100vh;
}
.stack{
  width:100%; max-width:415px;
  margin: 0 auto;
  display:flex; flex-direction:column; align-items:center;
  gap: 14px; padding: 0 10px;
}

.card{
  position:relative; width:100%; max-width:398px;
  border-radius:24px; background:#fff;
  padding:11px 14px 10px;
  box-shadow: 0 6px 14px rgba(0,0,0,.45);
  transition: transform .16s ease;
  border:3px solid #1f9b3b;
  text-decoration:none; color:inherit; display:block;
  animation: fade-in .35s ease both;
}
@keyframes fade-in { from{ opacity:0; transform: translateY(8px); } to{ opacity:1; transform:none; } }
.card{ will-change: transform; backface-visibility:hidden; transform: translateZ(0); }
.card:active{ transform: scale(.985) translateZ(0); }
.card[data-state="starting"]{ border-color:#e53935; animation: pulse-border 1.4s infinite; }
.card[data-state="started"]{ border-color:#9aa0a4; }
@keyframes pulse-border{ 0%,100%{ box-shadow: 0 0 0 0 rgba(229,57,53,.5); } 50%{ box-shadow: 0 0 0 6px rgba(229,57,53,0); } }

.row-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }
.row-body, .row-bottom{ display:flex; justify-content:space-between; align-items:flex-start; }
.row-body{ margin-top:8px; }
.row-bottom{ align-items:center; margin-top:10px; }

/* ── Başlıq sətri: TAM BİLET · Classic · ★ qazan (üst-üstə düşmür) ── */
.top-left{ display:flex; flex-direction:column; align-items:flex-start; gap:6px; min-width:0; }
.full-ticket{
  position:static; align-self:flex-start;
  background:#e21d18; color:#fff;
  font-size:9px; font-weight:900; letter-spacing:.5px;
  padding:3px 10px; border-radius:7px;
  box-shadow: 0 2px 4px rgba(0,0,0,.25); text-transform:uppercase;
  white-space:nowrap;
}
.chip-row{ display:flex; align-items:center; gap:8px; flex-wrap:nowrap; }
.classic{
  display:inline-flex; align-items:center; gap:3px;
  font-size: clamp(14px, 3.8vw, 17px); font-weight:800;
  padding: 7px 14px;
  border-radius:16px; width:max-content; line-height:1;
  background: linear-gradient(180deg,#e4d4a6 0%,#d3b262 100%);
  border: 1px solid #c9a84e; color:#fff; white-space:nowrap;
}
.classic .lbl{ color:#f6edd6; font-weight:600; font-size:12.5px; margin-right:2px; }
.stars-wrap{ position:relative; width:max-content; margin-left:0; display:flex; align-items:stretch; }
.stars{
  display:inline-flex; align-items:center; gap:6px;
  background:#2b343b; border-radius:16px;
  padding: 6px 12px; line-height:1; white-space:nowrap;
}
.stars .top{ display:flex; align-items:center; gap:3px; color:#f8c52e; font-size:16px; font-weight:800; }
.stars .top .star{ font-size:13px; }
.stars .win{ color:rgba(248,197,46,.85); font-size:10px; font-weight:700; letter-spacing:.3px; text-transform:lowercase; }
.mult{
  position:absolute; top:-8px; right:-8px;
  background:#f50402; color:#fff;
  font-size:10px; font-weight:900; line-height:1;
  min-width:22px; height:22px; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  box-shadow: 0 1px 3px rgba(0,0,0,.4);
}

.top-right{ display:flex; flex-direction:column; align-items:flex-end; gap:5px; line-height:1; flex-shrink:0; }
.status{
  display:inline-flex; align-items:center; gap:5px;
  background:#ededed; color:#7d7d7d;
  font-size:11.5px; font-weight:700; white-space:nowrap;
  padding:6px 11px; border-radius:11px; margin-bottom:0;
}
.status .material-symbols-outlined{ font-size:14px; }
.status.st-started{ background:#7f8386; color:#fff; }
.status.st-waiting{ background:#444; color:#fff; }
.status.st-starting{ background:#e53935; color:#fff; }

.time{ font-size:16px; font-weight:900; color:#555; letter-spacing:.5px; display:inline-flex; align-items:center; gap:4px; }
.time .material-symbols-outlined{ font-size:14px; }
.time.st-started{ color:#7f8386; }
.time.st-waiting{ color:#444; }
.time.st-starting{ color:#e53935; }

.body-left{ display:flex; flex-direction:column; flex:1; }
.prize{ display:flex; align-items:center; gap:7px; color:#1ea838; font-size: clamp(22px, 5.5vw, 30px); font-weight:900; line-height:1; }
.coins{ position:relative; width:28px; height:26px; flex:0 0 28px; }
.coin{ position:absolute; width:20px; height:11px; border-radius:50%; background: linear-gradient(180deg,#ffe27a,#e0a82e); border:1.5px solid #c8901f; box-shadow: 0 1px 0 #b97e1a; }
.coin.c1{ left:2px; bottom:0; }
.coin.c2{ left:5px; bottom:6px; }
.coin.c3{ left:8px; bottom:12px; }

/* ── Mərc dəyişməsi animasiyası ── */
.prize{ position:relative; }
.prize .js-prize{ transition: color .25s ease, transform .25s ease; display:inline-block; }
.prize.up .js-prize{ color:#12b84a; transform: scale(1.12); }
.prize.down .js-prize{ color:#e04b4b; transform: scale(.93); }
.prize-float{
  position:absolute; left:36px; top:0;
  font-size:13px; font-weight:900; pointer-events:none; opacity:0; white-space:nowrap;
}
.prize-float.up{ color:#12b84a; animation: pf-up 1.15s ease forwards; }
.prize-float.down{ color:#e04b4b; animation: pf-down 1.15s ease forwards; }
@keyframes pf-up{ 0%{opacity:0;transform:translateY(6px) scale(.8);} 25%{opacity:1;transform:translateY(-14px) scale(1.05);} 100%{opacity:0;transform:translateY(-32px) scale(1);} }
@keyframes pf-down{ 0%{opacity:0;transform:translateY(-14px) scale(.8);} 25%{opacity:1;transform:translateY(2px) scale(1.05);} 100%{opacity:0;transform:translateY(22px) scale(1);} }

.players{ margin-top:6px; display:flex; align-items:baseline; gap:7px; }
.players .pcount{ font-size: clamp(22px, 6vw, 30px); font-weight:900; color:#2b2b2b; line-height:1; }
.players .ptext{ font-size:16px; color:#8f8f8f; font-weight:500; }

.slot{ width:120px; flex:0 0 120px; display:flex; flex-direction:column; align-items:flex-end; transform: translate(8px, 3px); }
.jackpot-text{ color:#d6303a; font-size:14px; font-weight:900; letter-spacing:.5px; margin-bottom:2px; margin-right:6px; text-transform:uppercase; }
/* ── Animasiyalı JACKPOT ── */
.pc-up{ animation: pcUp .6s ease } .pc-down{ animation: pcDown .6s ease }
@keyframes pcUp{ 0%{ transform:translateY(6px); opacity:.2; color:#5fd07a } 100%{ transform:none; opacity:1 } }
@keyframes pcDown{ 0%{ transform:translateY(-6px); opacity:.2; color:#ff8a80 } 100%{ transform:none; opacity:1 } }
.jackpot-text{ position:relative; background:linear-gradient(90deg,#ff5252,#ffd166,#ff5252); background-size:200% 100%; -webkit-background-clip:text; background-clip:text; color:transparent; animation: jpShine 2.6s linear infinite; text-shadow:none; }
@keyframes jpShine{ 0%{ background-position:0% 0 } 100%{ background-position:200% 0 } }
.machine{ filter: drop-shadow(0 0 0 rgba(245,197,24,0)); transition: filter .3s ease; }
.machine.hit{ animation: jpShake .6s ease; filter: drop-shadow(0 0 10px rgba(255,196,0,.85)); }
@keyframes jpShake{ 0%,100%{ transform:translateY(0) } 20%{ transform:translateY(-3px) rotate(-1.5deg) } 45%{ transform:translateY(2px) rotate(1.5deg) } 70%{ transform:translateY(-1px) } }
.barrel{ overflow:hidden; }
.barrel::before{ content:''; position:absolute; inset:0; border-radius:22px; background:linear-gradient(115deg,transparent 30%,rgba(255,255,255,.65) 48%,transparent 62%); transform:translateX(-120%); animation: jpSweep 3.4s ease-in-out infinite; pointer-events:none; }
@keyframes jpSweep{ 0%,72%{ transform:translateX(-120%) } 100%{ transform:translateX(120%) } }
.reel{ position:relative; overflow:hidden; }
.reel.spin{ animation: jpReel .42s cubic-bezier(.25,.9,.3,1); }
@keyframes jpReel{ 0%{ transform:translateY(-90%); filter:blur(1.4px) } 60%{ filter:blur(.4px) } 100%{ transform:translateY(0); filter:blur(0) } }
.jp-pop{ position:absolute; right:0; top:-16px; font-size:11px; font-weight:900; color:#ffd166; text-shadow:0 2px 6px rgba(0,0,0,.7); animation: jpPop 1.2s ease forwards; pointer-events:none; }
@keyframes jpPop{ 0%{ opacity:0; transform:translateY(6px) } 25%{ opacity:1 } 100%{ opacity:0; transform:translateY(-14px) } }
.machine{ position:relative; width:104px; height:42px; margin-right:2px; }
.barrel{
  position:absolute; bottom:4px; left:7px;
  width:90px; height:32px;
  background: linear-gradient(180deg,#f6d97e 0%,#eec253 40%,#d6a431 100%);
  border-radius:22px;
  border:2px solid #c08e22;
  box-shadow: 0 3px 5px rgba(0,0,0,.3), inset 0 2px 3px rgba(255,255,255,.5);
  display:flex; align-items:center; justify-content:center;
  gap:3px; padding: 0 4px;
}
.reel{
  width:20px; height:23px; border-radius:4px;
  background: linear-gradient(180deg,#fffae6,#f3e3b0);
  border:1px solid #c8a33f;
  display:flex; align-items:center; justify-content:center;
  font-size:16px; font-weight:900; color:#7a1410;
  box-shadow: inset 0 -3px 4px rgba(180,140,40,.35);
}
.barrel::after{
  content:''; position:absolute; bottom:-8px; left:50%; transform:translateX(-50%);
  width:26px; height:8px;
  background: linear-gradient(180deg,#d6a431,#a8781d);
  border-radius:0 0 6px 6px;
}

.numbers{ display:flex; gap:7px; flex-wrap:wrap; align-items:center; max-width:62%; }
.num-ball{
  width: clamp(26px, 7vw, 32px); height: clamp(26px, 7vw, 32px);
  border-radius:50%; background:#fff;
  border:2px solid #3a3a3a; color:#2b2b2b;
  font-size: clamp(12px, 3.5vw, 15px); font-weight:800;
  display:flex; align-items:center; justify-content:center;
}

.amount-pill{
  display:inline-flex; align-items:center; gap:6px;
  background: linear-gradient(180deg,#9bd8bf,#74c6a8);
  color:#fff; font-size: clamp(13px, 4vw, 16px); font-weight:800;
  padding:6px 16px; border-radius:18px;
  box-shadow: 0 2px 4px rgba(0,0,0,.15);
  transition: transform .12s;
}
.amount-pill.resume{ background: linear-gradient(180deg,#54d57a,#15a62d); }
.amount-pill .material-symbols-outlined{ font-size:18px; }

.last-winner{
  display:flex; align-items:center; gap:6px;
  margin-top:7px; padding-top:7px;
  border-top:1px dashed #e6e6e6;
  font-size:12px; color:#6b6b6b;
}
.last-winner .lw-name{
  font-weight:800; color:#2b2b2b;
  max-width:90px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
}
.last-winner .lw-nums{ display:flex; gap:3px; flex:1; }
.last-winner .lw-nums i{
  font-style:normal; font-size:10px; font-weight:800;
  color:#fff; background:#1f9b3b; border-radius:50%;
  width:17px; height:17px; display:flex; align-items:center; justify-content:center;
}
.last-winner .lw-prize{
  font-weight:900; color:#1ea838;
  display:inline-flex; align-items:center; margin-left:auto;
}

.create-bar{ width:100%; max-width:398px; margin:0 auto 2px; display:flex; justify-content:flex-start; }
.btn-create{
  display:inline-flex; align-items:center; gap:6px;
  background: linear-gradient(180deg,#f8d34a 0%,#e0a800 100%);
  color:#3d0d62; text-decoration:none;
  font-size:13px; font-weight:900; letter-spacing:.2px;
  padding:9px 15px; border-radius:14px;
  border:1px solid rgba(255,255,255,.35);
  box-shadow: 0 4px 12px -4px rgba(0,0,0,.55);
}
.btn-create:active{ transform: scale(.97); }
.btn-create .material-symbols-outlined{ font-size:18px; }
.badge-private{
  position:absolute; top:10px; right:12px; z-index:4;
  background:#6b1fa8; color:#fff; font-size:9px; font-weight:900;
  padding:3px 8px; border-radius:8px; text-transform:uppercase;
}
.empty{ padding:28px 20px; text-align:center; color:rgba(255,255,255,.7); }

/* ── Responsive dəqiq medianlar ── */
@media (max-width:430px){
  body{ padding: 80px 6px 24px; }
  .stack{ padding:0 4px; }
  .card{ padding: 11px 11px 10px; }
  .slot{ transform: translate(2px, 3px); }
  .numbers{ max-width:60%; }
}
@media (max-width:370px){
  .classic{ padding:6px 11px; font-size:13.5px; }
  .classic .lbl{ font-size:11.5px; }
  .stars{ padding:5px 10px; gap:5px; }
  .stars .top{ font-size:14px; }
  .stars .win{ font-size:9px; }
  .chip-row{ gap:6px; }
  .slot{ width:108px; flex:0 0 108px; }
  .machine{ width:92px; }
  .barrel{ width:80px; }
  .reel{ width:18px; height:21px; font-size:14px; }
  .full-ticket{ font-size:8px; padding:3px 8px; }
  .prize{ font-size:22px; }
  .players .pcount{ font-size:22px; }
  .numbers{ max-width:55%; gap:5px; }
  .num-ball{ width:24px; height:24px; font-size:11px; }
  .amount-pill{ font-size:13px; padding:5px 12px; }
  .last-winner .lw-nums i{ width:15px; height:15px; font-size:9px; }
}
@media (max-width:320px){
  .row-top{ flex-wrap:wrap; gap:8px; }
  .top-right{ flex-direction:row; align-items:center; gap:6px; }
  .chip-row{ flex-wrap:wrap; }
  .prize{ font-size:20px; }
  .slot{ transform: translate(0, 0); }
}

/* Telefonun özündə “safe area” dəstəyi */
@supports (padding: max(0px)) {
  body{ padding-top: max(80px, calc(72px + env(safe-area-inset-top))); }
  .quick-nav{ padding-bottom: max(8px, env(safe-area-inset-bottom)); }
}
</style>
</head>
<body>

<%- include('partials/topnav', { user: user }) %>

<div class="stack">
  <div class="create-bar">
    <a class="btn-create" href="/room/create">
      <span class="material-symbols-outlined">add_circle</span> <%= t('room.create') %>
    </a>
  </div>
  <% if (!rooms.length) { %>
    <div class="empty"><%= t('room.empty') %></div>
  <% } %>
  <% rooms.forEach(function(room){ %>
    <a href="<%= room.hasJoined ? '/gamestart/' + room._id : '/join/' + room._id %>"
       class="card"
       style="border-color:<%= room.displayStatus === 'starting' ? '#e53935' : (room.displayStatus === 'started' ? '#9aa0a4' : '#1f9b3b') %>"
       data-room-id="<%= room._id %>"
       data-state="<%= room.displayStatus %>" data-private="<%= room.isCustom ? 1 : 0 %>">
      <% if (room.isCustom) { %><span class="badge-private"><%= t('room.private') %></span><% } %>
      <div class="row-top">
        <div class="top-left">
          <div class="full-ticket"><%= t('join.full_ticket') %></div>
          <div class="chip-row">
            <div class="classic"><span class="lbl">Classic</span><span><%= money(room.entryFee || 0, { symbol: false }) %></span><span><%= localeMeta.symbol %></span></div>
            <div class="stars-wrap">
              <div class="stars">
                <div class="top"><span class="star">★</span><span class="js-star-prize"><%= room.starPrize || Math.round((room.entryFee || 1) * 100) %></span></div>
                <div class="win"><%= t('room.win') %></div>
              </div>
              <div class="mult js-mult"><%= room.prizeMultiplier || 'x2' %></div>
            </div>
          </div>
        </div>
        <div class="top-right">
          <span class="status js-status st-<%= room.displayStatus %>">
            <% if (room.displayStatus==='started') { %><span class="material-symbols-outlined">play_circle</span><%= t('room.started') %>
            <% } else if (room.displayStatus==='starting') { %><span class="material-symbols-outlined">hourglass_top</span><%= t('room.starting') %>
            <% } else { %><span class="material-symbols-outlined">group</span><%= t('room.waiting') %><% } %>
          </span>
          <span class="time js-time st-<%= room.displayStatus %>">
            <span class="material-symbols-outlined">schedule</span>
            <span data-secs="<%= room.secsLeft %>" data-status="<%= room.displayStatus %>" data-slots="<%= room.slotsLeft %>" data-size="<%= room.roomSize %>" class="js-time-text">
              <% if (room.displayStatus === 'started') { var s = Number(room.secsLeft||0), m = Math.floor(s/60), ss = s%60; %>
                <%= (m<10?'0':'') + m + ':' + (ss<10?'0':'') + ss %>
              <% } else { %>
                <%= (room.playerCount || 0) %>/<%= room.roomSize %>
              <% } %>
            </span>
          </span>
        </div>
      </div>
      <div class="row-body">
        <div class="body-left">
          <div class="prize">
            <div class="coins"><i class="coin c1"></i><i class="coin c2"></i><i class="coin c3"></i></div>
            <span class="js-prize" data-val="<%= Number(room.prize || 0).toFixed(2) %>"><%= money(room.prize || 0, { symbol: false }) %></span><span><%= localeMeta.symbol %></span>
          </div>
          <div class="players"><span class="pcount js-players" data-real="<%= room.playerCount %>"><%= room.playerCount %></span><span class="ptext"><%= t('room.online') %></span></div>
        </div>
        <div class="slot" <%= room.jackpotEnabled ? '' : 'style="display:none"' %>>
          <div class="jackpot-text"><%= t('room.jackpot') %></div>
          <div class="machine">
            <div class="barrel js-barrel" data-jackpot="<%= Number(room.jackpot || 0) %>" data-ratio="<%= Number(room.jackpotRatio || 1) %>">
              <% var jp = String(Math.round((Number(room.jackpot||0))*( Number(room.jackpotRatio||1) ))).padStart(3,'0').slice(-3).split(''); %>
              <div class="reel"><%= jp[0] %></div><div class="reel"><%= jp[1] %></div><div class="reel"><%= jp[2] %></div>
            </div>
          </div>
        </div>
      </div>
      <div class="row-bottom">
        <div class="numbers js-last-nums">
          <% if ((room.lastWinnerNums || []).length) {
               (room.lastWinnerNums || []).slice(0,5).forEach(function(n){ %>
            <span class="num-ball"><%= n %></span>
          <%   });
             } else { %>
            <span style="font-size:12px;color:#9aa0a4;font-weight:700;"><%= t('room.last_winners') %></span>
          <% } %>
        </div>
        <div class="amount-pill <%= room.hasJoined ? 'resume' : '' %>">
          <span class="material-symbols-outlined"><%= room.hasJoined ? 'play_circle' : 'sports_esports' %></span>
          <span class="js-pill"><%= room.hasJoined ? t('room.return') : money(room.entryFee || 0) %></span>
        </div>
      </div>
      <% if (room.lastWinnerName) { %>
      <div class="last-winner">
        <span class="lw-name"><%= room.lastWinnerName %></span>
        <span class="lw-nums"><% (room.lastWinnerNums||[]).slice(0,5).forEach(function(n){ %><i><%= n %></i><% }) %></span>
        <span class="lw-prize"><%= money(room.winnerPrize || 0) %></span>
      </div>
      <% } %>
    </a>
  <% }) %>
</div>

<!-- Footer həmişə səhifənin ən axırında -->
<%- include('partials/footer', { activePage: 'home' }) %>

<script>
function fmtTime(s){ s=Math.max(0,Math.round(s)); var m=Math.floor(s/60), ss=s%60; return (m<10?'0':'')+m+':'+(ss<10?'0':'')+ss; }
function setJackpot(el,val,ratio){
  if(!el) return;
  var d = Math.round((parseFloat(val)||0)*(parseFloat(ratio)||1));
  var s = String(d).padStart(3,'0').slice(-3);
  var prev = el.dataset.shown || '';
  var reels = el.querySelectorAll('.reel');
  if (reels.length < 3) return;
  for (var i=0;i<3;i++){
    if (prev[i] === s[i]) continue;
    (function(reel, digit, idx){
      setTimeout(function(){
        reel.classList.remove('spin');
        void reel.offsetWidth;
        reel.classList.add('spin');
        var steps = 6, n = 0;
        var iv = setInterval(function(){
          n++;
          reel.textContent = String(Math.floor(Math.random()*10));
          if (n >= steps){ clearInterval(iv); reel.textContent = digit; }
        }, 45);
      }, idx * 90);
    })(reels[i], s[i], i);
  }
  if (prev && prev !== s){
    var machine = el.closest('.machine');
    if (machine){
      machine.classList.remove('hit'); void machine.offsetWidth; machine.classList.add('hit');
      setTimeout(function(){ machine.classList.remove('hit'); }, 700);
      var diff = parseInt(s,10) - parseInt(prev || '0',10);
      if (diff > 0){
        var pop = document.createElement('span');
        pop.className = 'jp-pop';
        pop.textContent = '+' + diff;
        machine.appendChild(pop);
        setTimeout(function(){ if (pop.parentNode) pop.parentNode.removeChild(pop); }, 1200);
      }
    }
  }
  el.dataset.shown = s;
}
/* ── Otağın ümumi mərci: + / − animasiyalı ── */
function animatePrize(card, value){
  var wrap = card.querySelector('.prize');
  var el   = card.querySelector('.js-prize');
  if (!wrap || !el) return;
  var from = parseFloat(el.dataset.val);
  if (!isFinite(from)) from = parseFloat(el.textContent) || 0;
  var delta = Math.round((value - from) * 100) / 100;
  el.dataset.val = value.toFixed(2);
  if (Math.abs(delta) < 0.005){ el.textContent = window.olMoney(value, false); return; }

  var f = document.createElement('span');
  f.className = 'prize-float ' + (delta > 0 ? 'up' : 'down');
  f.textContent = (delta > 0 ? '+' : '−') + window.olMoney(Math.abs(delta));
  wrap.appendChild(f);
  setTimeout(function(){ if (f.parentNode) f.parentNode.removeChild(f); }, 1250);

  wrap.classList.remove('up','down');
  void wrap.offsetWidth;
  wrap.classList.add(delta > 0 ? 'up' : 'down');
  setTimeout(function(){ wrap.classList.remove('up','down'); }, 750);

  var start = performance.now(), dur = 800;
  (function step(now){
    var t = Math.min(1, (now - start) / dur);
    var e = 1 - Math.pow(1 - t, 3);
    el.textContent = window.olMoney(from + delta * e, false);
    if (t < 1) requestAnimationFrame(step); else el.textContent = window.olMoney(value, false);
  })(start);
}

function setStatusText(status){
  if (status==='started') return '<span class="material-symbols-outlined">play_circle</span>'+window.OL_T.started;
  if (status==='starting') return '<span class="material-symbols-outlined">hourglass_top</span>'+window.OL_T.starting;
  return '<span class="material-symbols-outlined">group</span>'+window.OL_T.waiting;
}
function applyState(card, info){
  card.dataset.state = info.status;
  card.style.borderColor = info.status==='starting' ? '#e53935' : (info.status==='started' ? '#9aa0a4' : '#1f9b3b');
  var st = card.querySelector('.js-status');
  if (st){ st.className='status js-status st-'+info.status; st.innerHTML = setStatusText(info.status); }
  var tm = card.querySelector('.js-time-text');
  if (tm){
    tm.dataset.secs = info.secs_left || 0;
    tm.dataset.status = info.status;
    // Başlama vaxtı yoxdur: otaq dolan kimi başlayır → gözləmədə iştirakçı sayı göstərilir
    tm.textContent = info.status === 'started'
      ? fmtTime(info.secs_left || 0)
      : (Number(info.starts_in || 0) > 0
          ? window.OL_T.starting + ' ' + Number(info.starts_in) + 's'
          : (info.player_count || 0) + '/' + (info.room_size || 5));
  }
  var tmWrap = card.querySelector('.js-time');
  if (tmWrap) tmWrap.className = 'time js-time st-'+info.status;
  var pe = card.querySelector('.js-players');
  if (pe){ pe.dataset.real = info.player_count; if ((parseInt(pe.textContent,10)||0) < info.player_count) pe.textContent = info.player_count; }
  animatePrize(card, parseFloat(info.prize || 0));
  var barrel = card.querySelector('.js-barrel');
  if (barrel && info.jackpot!==null && info.jackpot!==undefined) setJackpot(barrel, info.jackpot, info.jackpot_ratio||1);

  // Son qalibin real-time yenilənməsi — növbəti qalibə qədər saxlanılır.
  var lw = card.querySelector('.last-winner');
  if (info.last_winner_name){
    var nums = (info.last_winner_nums||[]).slice(0,5).map(function(n){ return '<i>'+n+'</i>'; }).join('');
    var prize = window.olMoney(info.winner_prize||0);
    var html = '<span class="lw-name">'+info.last_winner_name+'</span>'
             + '<span class="lw-nums">'+nums+'</span>'
             + '<span class="lw-prize">'+prize+'</span>';
    if (lw){ lw.innerHTML = html; }
    else {
      lw = document.createElement('div');
      lw.className = 'last-winner';
      lw.innerHTML = html;
      card.appendChild(lw);
    }
  }
}
/* ── Onlayn oyunçu simulyasiyası: otaqlara giriş/çıxış effekti ── */
(function(){
  function bump(el, next){
    if (!el) return;
    var cur = parseInt(el.textContent, 10) || 0;
    if (next === cur) return;
    el.textContent = next;
    el.classList.remove('pc-up','pc-down');
    void el.offsetWidth;
    el.classList.add(next > cur ? 'pc-up' : 'pc-down');
    setTimeout(function(){ el.classList.remove('pc-up','pc-down'); }, 700);
  }
  function step(){
    document.querySelectorAll('.card').forEach(function(card){
      if (card.dataset.private === '1') return;           // şəxsi otaqlarda simulyasiya yoxdur
      if (card.dataset.state === 'started') return;
      var el = card.querySelector('.js-players');
      if (!el) return;
      var real = parseInt(el.dataset.real || el.textContent, 10) || 0;
      var size = parseInt(card.querySelector('.js-time-text') ? card.querySelector('.js-time-text').dataset.size : 5, 10) || 5;
      var shown = parseInt(el.textContent, 10) || real;
      var delta = Math.random() < 0.5 ? -1 : 1;
      var next = Math.min(size, Math.max(real, shown + delta));
      bump(el, next);
    });
    setTimeout(step, 2600 + Math.random() * 3200);
  }
  setTimeout(step, 2200);
})();

(function(){
  function tick(){
    document.querySelectorAll('.js-time-text').forEach(function(el){
      if (el.dataset.status !== 'started') return;   // gözləmədə geri sayım yoxdur
      var v = parseInt(el.dataset.secs||'0', 10);
      if (v>0){ v-=1; el.dataset.secs = v; }
      el.textContent = fmtTime(v);
    });
  }
  setInterval(tick, 1000);

  function poll(){
    fetch('/api/rooms-status', { credentials: 'same-origin' })
      .then(function(r){ return r && r.ok ? r.json() : null; })
      .then(function(data){
        if (!Array.isArray(data)) return;
        var needsReload = false;
        data.forEach(function(info){
          var card = document.querySelector('[data-room-id="'+info.id+'"]');
          if (info.removed){
            // Oyunu başlamış otaq ana səhifədən silinir
            if (card && card.parentNode) card.parentNode.removeChild(card);
            return;
          }
          if (!card){ needsReload = true; return; }   // yeni açılan otaq
          applyState(card, info);
        });
        // Təhlükəsizlik: hər hansı uyğunsuzluq halında səhifə sonsuz
        // yenilənməsin — bir səhifə açılışında maksimum 1 dəfə reload.
        if (needsReload && !window.__reloading){
          var lastReload = 0;
          try { lastReload = Number(sessionStorage.getItem('roomsReloadAt') || 0); } catch(e){}
          if (Date.now() - lastReload < 15000) return;
          try { sessionStorage.setItem('roomsReloadAt', String(Date.now())); } catch(e){}
          window.__reloading = true;
          setTimeout(function(){ window.location.reload(); }, 400);
        }
      })
      .catch(function(){ /* sayt yatır – sessiz */ });
  }
  poll();
  setInterval(poll, 3000);
})();
</script>
</body>
</html>
