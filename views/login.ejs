<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Giriş · Birloto.com</title>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Rubik',sans-serif;background:#2d0b4e;color:#fff;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}.card{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:24px;width:100%;max-width:380px}h1{font-size:24px;font-weight:900;margin-bottom:6px}.sub{color:rgba(255,255,255,.6);font-size:13px;margin-bottom:18px}label{display:block;font-size:12px;font-weight:700;color:rgba(255,255,255,.7);margin:10px 0 6px}input{width:100%;padding:12px 14px;background:rgba(0,0,0,.25);border:1px solid rgba(255,255,255,.18);border-radius:10px;color:#fff;font-family:'Rubik';font-size:14px;outline:0}input:focus{border-color:#f5c518}.btn{width:100%;margin-top:18px;padding:13px;background:linear-gradient(180deg,#5a90ee,#3f6fd4);color:#fff;border:none;border-radius:12px;font-family:'Rubik';font-weight:800;font-size:15px;cursor:pointer}.err{background:rgba(232,0,26,.18);border:1px solid rgba(232,0,26,.35);color:#ffd0d0;padding:10px;border-radius:10px;margin-bottom:12px;font-size:13px}.link{display:block;margin-top:14px;text-align:center;color:#f5c518;font-weight:700;font-size:13px;text-decoration:none}.brand-link{display:block;text-align:center;margin-bottom:14px;font-size:26px;font-weight:900;color:#fff;text-decoration:none}.brand-link span{color:#e30613}</style>
</head>
<body>
<form class="card" method="POST" action="/login">
  <a class="brand-link" href="/"><span>Bir</span>loto.com</a>
  <h1>Giriş</h1><div class="sub">Hesabınıza daxil olun</div>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <label>İstifadəçi adı və ya e-poçt</label>
  <input name="username" required>
  <label>Şifrə</label>
  <input name="password" type="password" required minlength="6">
  <button class="btn" type="submit">Daxil ol</button>
  <a class="link" href="/register">Hesabınız yoxdur? Qeydiyyatdan keçin</a>
</form>
</body>
</html>
