<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Bir Loto – Giriş</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&family=Exo+2:wght@600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{--purple-bg:#3d0d62;--purple-dark:#2a0848;--purple-mid:#5a1a90;--gold:#f5c518;--orange-btn:#f5a623}@keyframes float1{0%,100%{transform:translateY(0) rotate(-15deg)}50%{transform:translateY(-8px) rotate(-15deg)}}@keyframes float2{0%,100%{transform:translateY(0) rotate(12deg)}50%{transform:translateY(-6px) rotate(12deg)}}@keyframes pulse-logo{0%,100%{box-shadow:0 0 0 0 rgba(233,30,99,.35)}70%{box-shadow:0 0 0 14px rgba(233,30,99,0)}}@keyframes fadeInUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}*{box-sizing:border-box;margin:0;padding:0}::-webkit-scrollbar{display:none}html{background:#3d0d62;overflow-x:hidden;width:100%}body{font-family:'Nunito','Exo 2',Helvetica,Arial,sans-serif;background-color:#3d0d62;color:#fff;min-height:100vh;overflow-x:hidden;position:relative}.hero{padding-top:18px;min-height:100vh;position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 30%,rgba(120,40,200,.6) 0%,transparent 65%)}.hero::before{content:'';position:absolute;inset:0;background-image:radial-gradient(circle at 15% 25%,rgba(255,255,255,.04) 1px,transparent 1px),radial-gradient(circle at 80% 15%,rgba(255,255,255,.06) 1px,transparent 1px),radial-gradient(circle at 60% 70%,rgba(255,255,255,.04) 1px,transparent 1px),radial-gradient(circle at 30% 80%,rgba(255,255,255,.05) 1px,transparent 1px);background-size:120px 120px,90px 90px,150px 150px,80px 80px;pointer-events:none}.bingo-card{position:absolute;background:linear-gradient(135deg,#7b35c4,#5a1a90);border-radius:12px;padding:6px;box-shadow:0 8px 24px rgba(0,0,0,.5)}.grid{display:grid;gap:3px}.g5{grid-template-columns:repeat(5,1fr)}.bc-cell{width:26px;height:26px;border-radius:5px;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;color:rgba(255,255,255,.85)}.bc-cell.empty{background:rgba(255,255,255,.06)}.bc-card-1{top:68px;left:-22px;transform:rotate(-18deg);animation:float1 4s ease-in-out infinite;z-index:2}.bc-card-2{top:55px;right:-18px;transform:rotate(14deg);animation:float2 3.5s ease-in-out infinite;z-index:2}.lball{position:absolute;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;color:#fff;box-shadow:inset 0 -4px 8px rgba(0,0,0,.3),inset 0 3px 6px rgba(255,255,255,.4),0 4px 10px rgba(0,0,0,.4);z-index:3}.lball::before{content:'';position:absolute;top:8%;left:15%;width:30%;height:22%;background:rgba(255,255,255,.35);border-radius:50%;transform:rotate(-20deg)}.lb-red{background:radial-gradient(circle at 35% 30%,#ff7070,#cc1010)}.lb-blue{background:radial-gradient(circle at 35% 30%,#60a0ff,#1a3fbf)}.lb-green{background:radial-gradient(circle at 35% 30%,#60e060,#0d8c0d)}.content-wrap{position:relative;z-index:10;max-width:414px;margin:0 auto;padding:100px 20px 30px}.logo-center{text-align:center;margin-bottom:26px;animation:fadeInUp .6s ease}.logo-main{font-family:'Exo 2','Nunito',Helvetica,Arial,sans-serif;font-size:42px;font-weight:900;letter-spacing:-1px;line-height:1}.logo-main .red{color:#e8001a}.logo-main .white{color:#fff}.logo-ball{display:inline-block;width:18px;height:18px;border-radius:50%;background:#fff;margin:0 1px 2px 1px;vertical-align:baseline}.logo-sub{font-size:13px;color:rgba(255,255,255,.5);margin-top:6px;letter-spacing:.5px}.form-card{background:linear-gradient(145deg,rgba(107,47,168,.55),rgba(45,8,72,.7));border:1px solid rgba(255,255,255,.15);border-radius:24px;padding:28px 22px;backdrop-filter:blur(12px);animation:fadeInUp .7s ease}.form-title{font-size:22px;font-weight:900;text-align:center;margin-bottom:22px}.form-group{margin-bottom:16px}.form-label{display:block;font-size:12px;font-weight:800;color:rgba(255,255,255,.7);margin-bottom:6px;letter-spacing:.5px;text-transform:uppercase}.form-input{width:100%;padding:13px 16px;background:rgba(255,255,255,.1);border:1.5px solid rgba(255,255,255,.2);border-radius:14px;color:#fff;font-size:15px;font-weight:700;font-family:'Nunito',sans-serif;outline:none;transition:border-color .2s}.form-input:focus{border-color:#f5c518}.form-input::placeholder{color:rgba(255,255,255,.35)}.pwd-wrap{position:relative}.pwd-wrap .form-input{padding-right:48px}.eye-btn{position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:rgba(255,255,255,.5);display:flex;align-items:center}.error-msg{background:rgba(232,0,26,.15);border:1px solid rgba(232,0,26,.3);border-radius:10px;padding:10px 14px;font-size:13px;color:#ff8080;margin-bottom:14px;text-align:center}.btn-login,.btn-register{width:100%;padding:15px;color:#fff;font-size:16px;font-weight:900;border:none;border-radius:16px;cursor:pointer;font-family:'Nunito',sans-serif;margin-top:4px}.btn-login{background:linear-gradient(180deg,#ffd060 0%,#f59200 100%);box-shadow:0 4px 14px rgba(245,162,35,.45)}.btn-register{background:linear-gradient(180deg,#9b4dd4 0%,#6b1fa8 100%);margin-top:12px}.register-link{text-align:center;font-size:13px;color:rgba(255,255,255,.5);margin-top:18px}.register-link a{color:#f5c518;font-weight:800;text-decoration:none}
</style>
</head>
<body>
<div class="hero">
  <div class="bingo-card bc-card-1"><div class="grid g5"><div class="bc-cell empty"></div><div class="bc-cell">89</div><div class="bc-cell empty"></div><div class="bc-cell empty"></div><div class="bc-cell empty"></div><div class="bc-cell">8</div><div class="bc-cell">36</div><div class="bc-cell empty"></div><div class="bc-cell empty"></div><div class="bc-cell empty"></div><div class="bc-cell">79</div><div class="bc-cell empty"></div><div class="bc-cell empty"></div><div class="bc-cell empty"></div><div class="bc-cell empty"></div></div></div>
  <div class="bingo-card bc-card-2"><div class="grid g5"><div class="bc-cell empty"></div><div class="bc-cell">12</div><div class="bc-cell">25</div><div class="bc-cell empty"></div><div class="bc-cell">66</div><div class="bc-cell empty"></div><div class="bc-cell empty"></div><div class="bc-cell">41</div><div class="bc-cell empty"></div><div class="bc-cell">72</div></div></div>
  <div class="lball lb-red" style="width:38px;height:38px;font-size:13px;top:130px;left:38px;">47</div>
  <div class="lball lb-blue" style="width:32px;height:32px;font-size:12px;top:175px;right:44px;">13</div>
  <div class="lball lb-green" style="width:26px;height:26px;font-size:11px;top:105px;right:80px;">82</div>
  <div class="content-wrap">
    <div class="logo-center"><div class="logo-main"><span class="red">Bır</span><span class="logo-ball"></span><span class="white">loto.com</span></div><div class="logo-sub">Azərbaycanın tombala platforması</div></div>
    <div class="form-card">
      <div class="form-title">Hesabınıza Giriş edin</div>
      <% if (error) { %><div class="error-msg"><%= error %></div><% } %>
      <form method="POST" action="/login">
        <div class="form-group"><label class="form-label">İstifadəçi adı və ya telefon</label><input class="form-input" type="text" name="login" placeholder="İstifadəçi adı daxil edin" required></div>
        <div class="form-group"><label class="form-label">Şifrə</label><div class="pwd-wrap"><input class="form-input" type="password" name="password" id="pwdInput" placeholder="Şifrəni daxil edin" required><button type="button" class="eye-btn" onclick="togglePwd()"><svg id="eyeIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button></div></div>
        <button type="submit" class="btn-login">GİRİŞ</button>
      </form>
      <button class="btn-register" onclick="location.href='/register'">QEYDİYYAT</button>
      <div class="register-link">Hesab yaratmaqla <a href="#">Qaydalar və Şərtləri</a> qəbul etmiş olursunuz.</div>
    </div>
  </div>
</div>
<script>function togglePwd(){const i=document.getElementById('pwdInput'),ic=document.getElementById('eyeIcon'),show=i.type==='password';i.type=show?'text':'password';ic.innerHTML=show?'<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>':'<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';}</script>
</body>
</html>