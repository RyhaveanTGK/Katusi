<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Admin – Əməliyyatlar</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*{ box-sizing:border-box; margin:0; padding:0; }
body{ background:#1a0a2e; color:#fff; font-family:'Inter',sans-serif; min-height:100vh; }
.topbar{
  background:#300b51;
  border-bottom:1px solid rgba(255,255,255,.15);
  padding:14px 20px;
  display:flex; align-items:center; justify-content:space-between;
  position:sticky; top:0; z-index:100;
}
.tb-title{ font-size:18px; font-weight:900; }
.tb-user{ font-size:13px; color:rgba(255,255,255,.6); }

.wrap{ max-width:820px; margin:0 auto; padding:20px 16px 40px; }

.section-title{
  font-size:14px; font-weight:800;
  margin: 14px 0 12px; padding-bottom:6px;
  border-bottom:1px solid rgba(255,255,255,.08);
}

.filter-row{
  display:flex; gap:8px; margin-bottom:14px;
  flex-wrap:wrap;
}
.chip{
  padding:7px 14px; border-radius:99px;
  font-size:12px; font-weight:700;
  background: rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.15);
  color:rgba(255,255,255,.7);
  cursor:pointer; text-decoration:none;
}
.chip.active{ background:#5c2491; color:#fff; border-color: #5c2491; }

.txn-card{
  background: rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.10);
  border-radius:14px;
  padding:14px; margin-bottom:10px;
}
.txn-head{ display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap; }
.txn-meta{ font-size:11px; color:rgba(255,255,255,.55); margin-top:4px; }

.badge-status{
  font-size:10px; font-weight:800;
  border-radius:6px; padding:3px 8px;
}
.badge-pending  { background:#fff3cd; color:#856404; }
.badge-completed{ background:#d4edda; color:#155724; }
.badge-rejected { background:#f8d7da; color:#721c24; }

.amount{ font-size:20px; font-weight:900; color:#f5c518; }
.amount.deposit-amount{ color:#1cb85d; }
.amount.withdraw-amount{ color:#cc1010; }

.detail-row{ display:flex; gap:8px; flex-wrap:wrap; margin-top:8px; font-size:12px; color:rgba(255,255,255,.65); }
.detail-row .item{ background:rgba(255,255,255,.07); padding:6px 10px; border-radius:8px; }

.action-row{
  display:flex; gap:8px; margin-top:12px;
}
.btn{
  padding:9px 16px; border:none; border-radius:10px;
  font-size:13px; font-weight:800; cursor:pointer;
  font-family:inherit;
}
.btn-approve{ background:linear-gradient(180deg,#1cb85d,#0d8c3e); color:#fff; }
.btn-reject{  background:linear-gradient(180deg,#e0556a,#c02a40); color:#fff; }
.btn-info{    background:rgba(245,197,24,.16); color:#f5c518; }

.empty-state{
  text-align:center; padding:40px 20px;
  color:rgba(255,255,255,.4);
}
.empty-state .icon{ font-size:48px; margin-bottom:10px; }

/* Telegram bar info */
.tg-bar{
  background: linear-gradient(135deg,#0088cc,#229ed9);
  border-radius:14px;
  padding:14px 16px;
  margin-bottom:18px;
  display:flex; align-items:center; gap:14px;
}
.tg-bar .ic{
  width:46px; height:46px; border-radius:12px;
  background: rgba(255,255,255,.18);
  display:flex; align-items:center; justify-content:center;
  flex-shrink:0;
}
.tg-bar .body{ flex:1; }
.tg-bar .ttl{ font-size:14px; font-weight:800; }
.tg-bar .dsc{ font-size:12px; color:rgba(255,255,255,.85); margin-top:2px; }

.stat-row{
  display:grid; grid-template-columns:repeat(3,1fr); gap:10px;
  margin-bottom:18px;
}
.stat-box{
  background: rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.10);
  border-radius:14px; padding:12px; text-align:center;
}
.stat-val{ font-size:22px; font-weight:900; color:#f5c518; }
.stat-lbl{ font-size:10px; color:rgba(255,255,255,.55); text-transform:uppercase; letter-spacing:.4px; margin-top:4px; }

.receipt-thumb{
  margin-top:8px;
  display:flex; align-items:center; gap:8px;
  background:rgba(245,197,24,.10);
  border:1px dashed rgba(245,197,24,.4);
  border-radius:10px; padding:8px 10px;
  font-size:12px;
}
.receipt-thumb a{ color:#f5c518; font-weight:700; text-decoration:none; }
.receipt-thumb img{ width:48px; height:48px; border-radius:8px; object-fit:cover; border:1px solid rgba(255,255,255,.15); }
</style>
</head>
<body>
<div class="topbar">
  <div class="tb-title">🎰 Admin Panel</div>
  <div class="tb-user"><%= user.username %> | <a href="/" style="color:#f5c518;text-decoration:none;">Sayta qayıt</a></div>
</div>

<div class="wrap">
  <div class="tg-bar">
    <div class="ic">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="#fff"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12l-6.871 4.326-2.962-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.833.941z"/></svg>
    </div>
    <div class="body">
      <div class="ttl">Telegram bot inteqrasiyalıdır</div>
      <div class="dsc">Bütün deposit/withdraw sorğuları admin-ə Telegram vasitəsilə göndərilir. Burada &ldquo;Təsdiq&rdquo; / &ldquo;Rədd&rdquo; düymələri ilə rəsmi qərar verin.</div>
    </div>
  </div>

  <div class="stat-row">
    <div class="stat-box">
      <div class="stat-val" id="statPending">–</div>
      <div class="stat-lbl">Gözləyən</div>
    </div>
    <div class="stat-box">
      <div class="stat-val" id="statTotal">–</div>
      <div class="stat-lbl">Bu gün</div>
    </div>
    <div class="stat-box">
      <div class="stat-val" id="statAmount">–</div>
      <div class="stat-lbl">Cəm ₼</div>
    </div>
  </div>

  <div class="section-title">Gözləyən əməliyyatlar</div>
  <div class="filter-row">
    <a href="?status=pending"  class="chip <%= (query && query.status==='pending') || !query.status ? 'active' : '' %>">Gözləyən</a>
    <a href="?status=completed" class="chip <%= query && query.status==='completed' ? 'active' : '' %>">Tamamlanmış</a>
    <a href="?status=rejected"  class="chip <%= query && query.status==='rejected' ? 'active' : '' %>">Rədd edilmiş</a>
    <a href="?status=all"       class="chip <%= query && query.status==='all' ? 'active' : '' %>">Hamısı</a>
  </div>

  <% if (txns.length === 0) { %>
  <div class="empty-state">
    <div class="icon">📭</div>
    <div>Bu kateqoriyada əməliyyat yoxdur</div>
  </div>
  <% } %>

  <% txns.forEach(function(t) { %>
  <div class="txn-card">
    <div class="txn-head">
      <div>
        <div style="font-weight:900;font-size:15px;">
          <%= t.userId ? t.userId.username : '—' %>
          <span style="color:rgba(255,255,255,.4);font-weight:600;font-size:11px;">#<%= t.userId ? String(t.userId._id).slice(-6).toUpperCase() : '' %></span>
        </div>
        <div class="txn-meta"><%= new Date(t.createdAt).toLocaleString('az-AZ') %></div>
      </div>
      <div class="amount <%= t.type==='deposit' ? 'deposit-amount' : (t.type==='withdraw' ? 'withdraw-amount' : '') %>">
        <%= t.type==='deposit' ? '+' : (t.type==='withdraw' ? '-' : '') %><%= Number(t.amount).toFixed(2) %> ₼
      </div>
    </div>

    <div class="detail-row">
      <span class="item">📌 Növ: <b><%= t.type==='deposit' ? 'Depozit' : (t.type==='withdraw' ? 'Çıxarış' : t.type) %></b></span>
      <% if (t.method) { %><span class="item">💳 <%= t.method %></span><% } %>
      <% if (t.cryptoToken) { %><span class="item">🪙 <%= t.cryptoToken %> · <%= t.network || '' %></span><% } %>
      <% if (t.cardLast4) { %><span class="item">**** **** **** <%= t.cardLast4 %></span><% } %>
      <span class="item">
        <span class="badge-status badge-<%= t.status %>"><%= t.status==='pending'?'Gözləyir':t.status==='completed'?'Tamamlandı':'Rədd edildi' %></span>
      </span>
    </div>

    <% if (t.note) { %>
    <div style="font-size:12px;color:rgba(255,255,255,.6);margin-top:8px;">📝 <%= t.note %></div>
    <% } %>

    <% if (t.receiptImage) { %>
    <div class="receipt-thumb">
      <img src="<%= t.receiptImage %>" alt="receipt" onerror="this.style.display='none'">
      <a href="<%= t.receiptImage %>" target="_blank" rel="noopener">📎 Qəbzi aç</a>
      <span style="margin-left:auto;font-size:11px;color:rgba(255,255,255,.5);">Yüklənib</span>
    </div>
    <% } %>

    <% if (t.status === 'pending') { %>
    <form method="POST" action="/admin/transactions/<%= t._id %>/decision" id="txnForm-<%= t._id %>">
      <input type="hidden" name="reason" id="reason-<%= t._id %>" value="">
      <div class="action-row">
        <button type="button" class="btn btn-approve" onclick="decide('<%= t._id %>','approve')">✅ Təsdiq et</button>
        <button type="button" class="btn btn-reject"  onclick="decide('<%= t._id %>','reject')">❌ Rədd et</button>
      </div>
    </form>
    <% } else if (t.adminMessage) { %>
    <div style="font-size:12px;color:rgba(255,255,255,.6);margin-top:8px;">🛠 Admin qeyd: <%= t.adminMessage %></div>
    <% } %>
  </div>
  <% }); %>
</div>

<script>
function decide(id, kind){
  const reason = (kind === 'reject')
    ? (prompt('Rədd səbəbini yazın (istifadəçiyə görünəcək):', 'Sənəd/şəkil təsdiqlənmədi') || 'Rədd edildi')
    : '';
  const f = document.getElementById('txnForm-' + id);
  document.getElementById('reason-' + id).value = reason;
  f.action = '/admin/transactions/' + id + '/' + kind;
  f.submit();
}

// Sadə statistik (client-side, demo)
(async function(){
  try {
    const r = await fetch('/api/admin/stats', { credentials: 'same-origin' });
    if (!r.ok) return;
    const j = await r.json();
    document.getElementById('statPending').textContent = j.pending || 0;
    document.getElementById('statTotal').textContent   = j.today || 0;
    document.getElementById('statAmount').textContent  = (j.amount || 0).toFixed ? (j.amount).toFixed(2) + ' ₼' : '–';
  } catch (e) {}
})();
</script>
</body>
</html>
